---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh-CN" title="AI创业公益俱乐部 | 北美高校联盟华盛顿州分会（西雅图分会） (NACUAA WA)" description="北美高校联盟华州西雅图AI创业公益俱乐部（/ai），汇聚顶级AI专家、技术讲座、创业实操与知名VC对接。" path="/ai/">
  <div class="max-w-4xl mx-auto px-6 py-12 md:py-20 space-y-10">
    <!-- Breadcrumb & Director -->
    <div class="flex items-center justify-between flex-wrap gap-4">
      <a href="/clubs/" class="inline-flex items-center gap-x-2 text-xs text-blue-400 hover:text-blue-300 transition-colors">
        <i class="fa-solid fa-arrow-left"></i>
        <span>返回九大俱乐部总览</span>
      </a>
      <a href="mailto:tracy@wa.nacuaa.ai" class="px-3 py-1 rounded-full text-xs font-medium bg-blue-600/10 text-blue-400 border border-blue-500/20 hover:border-blue-400 transition-colors flex items-center gap-x-1.5">
        <i class="fa-regular fa-user text-xs"></i>
        <span>分会会长：Ashley Qi (戚霄)</span>
      </a>
    </div>

    <!-- Hero Card -->
    <div class="relative bg-gradient-to-br from-blue-950/50 via-slate-900/80 to-slate-950 border border-blue-800/40 rounded-3xl p-8 md:p-10 shadow-2xl backdrop-blur-md overflow-hidden">
      <div class="absolute -right-10 -top-10 w-64 h-64 bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="flex items-start gap-x-5">
        <div class="w-16 h-16 rounded-2xl bg-blue-600/20 text-blue-300 border border-blue-500/30 flex items-center justify-center text-3xl shrink-0 shadow-lg">
          🤖
        </div>
        <div class="space-y-2">
          <div class="text-xs text-blue-400 font-mono tracking-wider uppercase font-semibold">ALUMNI THEME CLUB #8</div>
          <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight heading-font">
            AI创业公益俱乐部 <span class="text-blue-300 text-2xl font-light block sm:inline font-sans">AI Venture & Impact Club</span>
          </h1>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
            <a href="https://nacuaa.ai" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-x-1.5 px-3 py-1 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs shadow-md transition-colors">
              <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
              <span>访问 AI 俱乐部独立官网 (nacuaa.ai) →</span>
            </a>
            <span class="px-2.5 py-1 rounded-lg bg-blue-950/60 border border-blue-800/60 text-blue-300 font-mono">
              <i class="fa-brands fa-weixin mr-1"></i> 进群群名：AI创业公益俱乐部
            </span>
          </div>
        </div>
      </div>
      <p class="text-slate-300 text-sm md:text-base leading-relaxed mt-6 border-t border-blue-900/30 pt-6">
        AI创业公益俱乐部是北美高校联盟在硅谷的核心前沿阵地，致力于汇聚湾区与全球最优秀的AI技术科学家、大模型架构师、创业者与公益创新先锋，通过高频硬核研讨、实战工作坊及投资对接，全力赋能AI项目落地。
      </p>
    </div>

    <!-- Core Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-blue-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-blue-600/10 text-blue-400 flex items-center justify-center text-lg mb-4 border border-blue-500/20">
          <i class="fa-solid fa-microchip"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">硬核前沿技术沙龙</h3>
        <p class="text-xs text-slate-400 leading-relaxed">聚焦智能体（AI Agents）、具身智能、World Models及开源实战。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-blue-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-blue-600/10 text-blue-400 flex items-center justify-center text-lg mb-4 border border-blue-500/20">
          <i class="fa-solid fa-hand-holding-dollar"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">创业路演与顶级VC对接</h3>
        <p class="text-xs text-slate-400 leading-relaxed">搭建硅谷知名投资机构与优秀校友初创项目闭门对接与融资绿色通道。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-blue-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-blue-600/10 text-blue-400 flex items-center justify-center text-lg mb-4 border border-blue-500/20">
          <i class="fa-solid fa-heart"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">AI for Good 公益赋能</h3>
        <p class="text-xs text-slate-400 leading-relaxed">利用AI技术赋能非营利机构、青少年教育与社区数字化发展。</p>
      </div>
    </div>

    <!-- Related Past Lectures & Notifications -->
    <div class="bg-slate-900/40 border border-slate-800/80 rounded-3xl p-6 space-y-4">
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-base font-bold text-white flex items-center gap-x-2">
          <i class="fa-solid fa-layer-group text-blue-400"></i>
          <span>俱乐部往期重磅讲座与通知回顾</span>
        </h3>
        <span class="text-xs text-blue-400">系列活动</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/posts/2026-08-18-software-agents-august-2026-progress-and-deployment-demo/" class="p-4 bg-slate-950/60 border border-slate-800 rounded-2xl hover:border-blue-500/40 transition-all group">
          <div class="text-[11px] text-blue-400 font-semibold mb-1">2026年8月18日 · 技术讲座</div>
          <div class="text-xs font-bold text-white group-hover:text-blue-300 line-clamp-2">
            软件智能体（Software Agents）2026年8月最新进展与部署实操演示 →
          </div>
        </a>
        <a href="/posts/2026-08-13-my-ai-and-me-entrepreneurship-second-fireside-chat/" class="p-4 bg-slate-950/60 border border-slate-800 rounded-2xl hover:border-blue-500/40 transition-all group">
          <div class="text-[11px] text-purple-400 font-semibold mb-1">2026年8月13日 · 创业对话</div>
          <div class="text-xs font-bold text-white group-hover:text-purple-300 line-clamp-2">
            “我的AI与我”创业炉边对话第二期：AI重塑个人生产力与出海实战 →
          </div>
        </a>
        <a href="/posts/2026-07-23-embodied-intelligence-physical-ai-third-lecture/" class="p-4 bg-slate-950/60 border border-slate-800 rounded-2xl hover:border-blue-500/40 transition-all group">
          <div class="text-[11px] text-blue-400 font-semibold mb-1">2026年7月23日 · 具身智能第3讲</div>
          <div class="text-xs font-bold text-white group-hover:text-blue-300 line-clamp-2">
            具身智能与物理AI第三讲：零基础上手 —— 以StackChan为例实操 →
          </div>
        </a>
        <a href="/posts/2026-07-10-embodied-intelligence-physical-ai-second-lecture/" class="p-4 bg-slate-950/60 border border-slate-800 rounded-2xl hover:border-blue-500/40 transition-all group">
          <div class="text-[11px] text-blue-400 font-semibold mb-1">2026年7月10日 · 具身智能第2讲</div>
          <div class="text-xs font-bold text-white group-hover:text-blue-300 line-clamp-2">
            具身智能与物理AI第二讲：从VLA到World Models的范式演进 →
          </div>
        </a>
        <a href="/posts/2026-07-08-ai-agents-entrepreneurship-club-lecture/" class="p-4 bg-slate-950/60 border border-slate-800 rounded-2xl hover:border-blue-500/40 transition-all group col-span-1 md:col-span-2">
          <div class="text-[11px] text-emerald-400 font-semibold mb-1">2026年7月8日 · 40年老兵拆解</div>
          <div class="text-xs font-bold text-white group-hover:text-emerald-300 line-clamp-2">
            《40年技术老兵硬核拆解：AI智能体如何帮内容创作者真正赚到钱》Peter Wu 实战分享 →
          </div>
        </a>
      </div>
    </div>

    <!-- Leadership / Contact Box -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-8 space-y-6">
      <h3 class="text-lg font-bold text-white border-l-4 border-blue-500 pl-3">📞 俱乐部负责人与入群联系</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-200">
        
        <div class="bg-slate-950/50 border border-slate-800 rounded-2xl p-4 space-y-1">
          <div class="font-bold text-white text-sm">Ashley Qi (戚霄)</div>
          <div class="text-slate-400">华盛顿州分会会长</div>
          <div class="flex flex-col gap-y-0.5">            <a href="mailto:ashley@nacuaa.ai" class="text-blue-400 hover:underline">ashley@nacuaa.ai</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
