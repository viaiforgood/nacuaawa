---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh-TW" title="掼蛋俱乐部 | 北美高校联盟華盛頓州分會（西雅圖分會） (NACUAA WA)" description="北美高校联盟華州西雅圖掼蛋俱乐部（/guandan），智力竞技与跨校联谊平台。" path="/zh-TW/guandan/">
  <div class="max-w-4xl mx-auto px-6 py-12 md:py-20 space-y-10">
    <!-- Breadcrumb & Director -->
    <div class="flex items-center justify-between flex-wrap gap-4">
      <a href="/zh-TW/clubs/" class="inline-flex items-center gap-x-2 text-xs text-blue-400 hover:text-blue-300 transition-colors">
        <i class="fa-solid fa-arrow-left"></i>
        <span>返回九大俱樂部總覽</span>
      </a>
      <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-600/10 text-blue-400 border border-blue-500/20 flex items-center gap-x-1.5">
        <i class="fa-regular fa-user text-xs"></i>
        <span>分會會長：戚霄 (Ashley Qi)</span>
      </span>
    </div>

    <!-- Hero Card -->
    <div class="relative bg-gradient-to-br from-purple-950/40 via-slate-900/80 to-slate-950 border border-purple-800/40 rounded-3xl p-8 md:p-10 shadow-2xl backdrop-blur-md overflow-hidden">
      <div class="absolute -right-10 -top-10 w-64 h-64 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="flex items-start gap-x-5">
        <div class="w-16 h-16 rounded-2xl bg-purple-600/20 text-purple-300 border border-purple-500/30 flex items-center justify-center text-3xl shrink-0 shadow-lg">
          🎴
        </div>
        <div class="space-y-2">
          <div class="text-xs text-purple-400 font-mono tracking-wider uppercase font-semibold">ALUMNI THEME CLUB #1</div>
          <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight heading-font">
            掼蛋俱乐部 <span class="text-purple-300 text-2xl font-light block sm:inline font-sans">Guandan Club</span>
          </h1>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
            <span class="px-2.5 py-1 rounded-lg bg-slate-950/60 border border-slate-800 text-slate-300 font-mono">
              URI: wa.nacuaa.ai/guandan
            </span>
            <span class="px-2.5 py-1 rounded-lg bg-purple-950/60 border border-purple-800/60 text-purple-300 font-mono">
              <i class="fa-brands fa-weixin mr-1"></i> 进群群名：華州西雅圖掼蛋俱乐部
            </span>
          </div>
        </div>
      </div>
      <p class="text-slate-300 text-sm md:text-base leading-relaxed mt-6 border-t border-purple-900/30 pt-6">
        掼蛋俱乐部由北美高校联盟華盛頓州分會（西雅圖分會）与華盛頓州分會（西雅圖分會）联合建立，面向旧金山湾区、硅谷及北加州广大高校校友及亲友，致力于搭建以牌会友、切磋牌艺、智力对决与跨校深厚联谊的平台。
      </p>
    </div>

    <!-- Core Pillars / Features -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-purple-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-purple-600/10 text-purple-400 flex items-center justify-center text-lg mb-4 border border-purple-500/20">
          <i class="fa-solid fa-brain"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">智力博弈与牌技交流</h3>
        <p class="text-xs text-slate-400 leading-relaxed">结合策略配合与概率决策，定期开展技巧解析与牌局复盘。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-purple-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-purple-600/10 text-purple-400 flex items-center justify-center text-lg mb-4 border border-purple-500/20">
          <i class="fa-solid fa-trophy"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">跨校友谊联赛</h3>
        <p class="text-xs text-slate-400 leading-relaxed">组织线下双打循环赛、高校积分榜对抗赛与年终总决赛。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-purple-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-purple-600/10 text-purple-400 flex items-center justify-center text-lg mb-4 border border-purple-500/20">
          <i class="fa-solid fa-people-arrows"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">轻松周末社交</h3>
        <p class="text-xs text-slate-400 leading-relaxed">以牌搭桥，轻松结识硅谷各领域优秀校友与志同道合的新朋友。</p>
      </div>
    </div>

    <!-- Related Post / Notification -->
    <div class="bg-slate-900/40 border border-slate-800/80 rounded-3xl p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-bold text-white flex items-center gap-x-2">
          <i class="fa-solid fa-bullhorn text-purple-400"></i>
          <span>俱乐部相关通知与精彩活动</span>
        </h3>
        <span class="text-xs text-slate-400">官方公告</span>
      </div>
      <div class="space-y-3">
        <a href="/posts/2026-08-21-agentic-guandan-opening-class/" class="block p-4 bg-slate-950/60 border border-slate-800 rounded-2xl hover:border-purple-500/40 hover:bg-slate-950 transition-all group">
          <div class="text-xs text-purple-400 mb-1 font-semibold">2026年8月21日 · 公告与讲座</div>
          <div class="text-sm font-bold text-white group-hover:text-purple-300 transition-colors mb-1">
            【重磅开课】智弈领航·掼蛋第一课：Agentic AI时代的智力竞技与跨校联谊 →
          </div>
          <p class="text-xs text-slate-400 line-clamp-2">深度融合前沿Agentic博弈思维与传统掼蛋默契配合，打造湾区最高水平的智力竞技社群。</p>
        </a>
        <a href="/posts/2026-08-19-four-clubs-announcement/" class="block p-4 bg-slate-950/60 border border-slate-800 rounded-2xl hover:border-purple-500/40 hover:bg-slate-950 transition-all group">
          <div class="text-xs text-slate-400 mb-1 font-semibold">2026年8月19日 · 联盟公告</div>
          <div class="text-sm font-bold text-white group-hover:text-purple-300 transition-colors mb-1">
            【官方公告】華盛頓州分會（西雅圖分會）与華盛頓州分會（西雅圖分會）联合成立主题俱乐部全面启用独立URI →
          </div>
        </a>
      </div>
    </div>

    <!-- Leadership / Contact Box -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-8 space-y-6">
      <h3 class="text-lg font-bold text-white border-l-4 border-purple-500 pl-3">📞 俱乐部负责人与入群联系</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-200">
        
        <div class="bg-slate-950/50 border border-slate-800 rounded-2xl p-4 space-y-1">
          <div class="font-bold text-white text-sm">戚霄 (Ashley Qi)</div>
          <div class="text-slate-400">華盛頓州分會會長</div>
          <div class="flex flex-col gap-y-0.5">            <a href="mailto:ashley@nacuaa.ai" class="text-blue-400 hover:underline">ashley@nacuaa.ai</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
