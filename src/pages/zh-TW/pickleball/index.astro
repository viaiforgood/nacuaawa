---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh-TW" title="匹克球俱乐部 | 北美高校联盟華盛頓州分會（西雅圖分會） (NACUAA WA)" description="北美高校联盟華州西雅圖匹克球俱乐部（/pickleball），推广潮流运动，组织教学与联赛。" path="/zh-TW/pickleball/">
  <div class="max-w-4xl mx-auto px-6 py-12 md:py-20 space-y-10">
    <!-- Breadcrumb & Director -->
    <div class="flex items-center justify-between flex-wrap gap-4">
      <a href="/zh-TW/clubs/" class="inline-flex items-center gap-x-2 text-xs text-blue-400 hover:text-blue-300 transition-colors">
        <i class="fa-solid fa-arrow-left"></i>
        <span>返回九大俱樂部總覽</span>
      </a>
      <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-600/10 text-blue-400 border border-blue-500/20 flex items-center gap-x-1.5">
        <i class="fa-regular fa-user text-xs"></i>
        <span>分會會長：戚霄 (Ashley Qi)</span>
      </span>
    </div>

    <!-- Hero Card -->
    <div class="relative bg-gradient-to-br from-amber-950/40 via-slate-900/80 to-slate-950 border border-amber-800/40 rounded-3xl p-8 md:p-10 shadow-2xl backdrop-blur-md overflow-hidden">
      <div class="absolute -right-10 -top-10 w-64 h-64 bg-amber-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="flex items-start gap-x-5">
        <div class="w-16 h-16 rounded-2xl bg-amber-600/20 text-amber-300 border border-amber-500/30 flex items-center justify-center text-3xl shrink-0 shadow-lg">
          🏓
        </div>
        <div class="space-y-2">
          <div class="text-xs text-amber-400 font-mono tracking-wider uppercase font-semibold">ALUMNI THEME CLUB #3</div>
          <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight heading-font">
            匹克球俱乐部 <span class="text-amber-300 text-2xl font-light block sm:inline font-sans">Pickleball Club</span>
          </h1>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
            <span class="px-2.5 py-1 rounded-lg bg-slate-950/60 border border-slate-800 text-slate-300 font-mono">
              URI: wa.nacuaa.ai/pickleball
            </span>
            <span class="px-2.5 py-1 rounded-lg bg-amber-950/60 border border-amber-800/60 text-amber-300 font-mono">
              <i class="fa-brands fa-weixin mr-1"></i> 进群群名：華州西雅圖匹克球俱乐部
            </span>
          </div>
        </div>
      </div>
      <p class="text-slate-300 text-sm md:text-base leading-relaxed mt-6 border-t border-amber-900/30 pt-6">
        匹克球是当下北美最流行、上手最快的新兴球类运动。俱乐部致力于打造友善、包容、充满活力的运动社区，定期提供零基础入门教学、固定球场约打与跨校友谊积分赛。
      </p>
    </div>

    <!-- Highlights -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-amber-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-amber-600/10 text-amber-400 flex items-center justify-center text-lg mb-4 border border-amber-500/20">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">零基础入门教学</h3>
        <p class="text-xs text-slate-400 leading-relaxed">资深球友一对一挥拍、发球规则讲解，10分钟轻松上手开打。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-amber-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-amber-600/10 text-amber-400 flex items-center justify-center text-lg mb-4 border border-amber-500/20">
          <i class="fa-solid fa-table-tennis-paddle-ball"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">常态化双打畅打</h3>
        <p class="text-xs text-slate-400 leading-relaxed">固定南湾/中半岛热门球场包场畅打，畅快流汗，结识球友。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-amber-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-amber-600/10 text-amber-400 flex items-center justify-center text-lg mb-4 border border-amber-500/20">
          <i class="fa-solid fa-medal"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">DUPR分级与校友赛</h3>
        <p class="text-xs text-slate-400 leading-relaxed">组织校友分级友谊赛，助力球友在欢乐氛围中不断进阶。</p>
      </div>
    </div>

    <!-- Leadership / Contact Box -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-8 space-y-6">
      <h3 class="text-lg font-bold text-white border-l-4 border-amber-500 pl-3">📞 俱乐部负责人与入群联系</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-200">
        
        <div class="bg-slate-950/50 border border-slate-800 rounded-2xl p-4 space-y-1">
          <div class="font-bold text-white text-sm">戚霄 (Ashley Qi)</div>
          <div class="text-slate-400">華盛頓州分會會長</div>
          <div class="flex flex-col gap-y-0.5">            <a href="mailto:ashley@nacuaa.ai" class="text-blue-400 hover:underline">ashley@nacuaa.ai</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
