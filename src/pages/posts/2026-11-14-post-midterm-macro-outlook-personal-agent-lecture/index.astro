            免费参加，欢迎转发！
          </p>
        </div>

        <hr class="border-slate-800 my-8" />

        <!-- Organizers -->
        <div class="bg-slate-950/40 border border-slate-900 p-6 rounded-2xl space-y-3 text-xs md:text-sm text-slate-300">
