---
import BaseLayout from '../../layouts/BaseLayout.astro';

const newsItems = [
  {
    title: "【重磅】北美高校联盟华盛顿州分会（西雅图分会）正式成立！戚霄（Ashley Qi）出任会长",
    date: "2026年9月17日",
    rawDate: "2026-09-17",
    category: "重大公告",
    badgeType: "primary",
    summary: "2026年9月17日，北美高校联盟华盛顿州分会（西雅图分会）正式宣告成立！由Ashley Qi（戚霄）出任首任会长。分会立足大西雅图地区及华盛顿州，凝聚美西北高校校友力量，设立九大特色俱乐部，携手全美各姊妹分会共创未来。",
    link: "/posts/2026-09-17-nacuaa-washington-state-chapter-established/"
  },
  {
    title: "【重大新闻】北美高校联盟四分会结为姊妹分会，并与浙江大学北卡罗来纳校友会建立战略合作",
    date: "2026年9月12日",
    rawDate: "2026-09-12",
    category: "重大新闻",
    badgeType: "primary",
    summary: "2026年9月12日，北美高校联盟北加州分会、硅谷分会、北卡罗来纳分会、华盛顿DC分会正式结为姊妹分会，互通活动、共享资源、互助校友。同日，浙江大学北卡罗来纳校友会与上述四个分会正式建立全面战略合作关系，携手服务跨区域广大校友。",
    link: "/posts/2026-09-12-four-chapters-sisterhood-and-zju-strategic-partnership/"
  },

  {
    title: "【技术前沿】AI 原生智能体安全与合规系列讲座开启，首讲录像与课件上线",
    date: "2026年9月1日",
    rawDate: "2026-09-01",
    category: "重要公告",
    badgeType: "primary",
    summary: "北卡浙大校友会与北美高校联盟·AI创业公益俱乐部开启新系列讲座：AI原生智能体 · 安全与合规。第一讲探讨从会聊天到能动手，智能体产品的安全红线与六类高发风险。录像回放与 6 份核心资料已全面上线。",
    link: "/posts/2026-09-01-ai-native-agent-security-compliance-lecture-1/"
  },
  {
    title: "【重磅】北美高校联盟华盛顿州（西雅图）高尔夫俱乐部成立，欢迎感兴趣的校友前来共建",
    date: "2026年8月27日",
    rawDate: "2026-08-27",
    category: "俱乐部资讯",
    badgeType: "amber",
    summary: "北美高校联盟华盛顿州分会高尔夫俱乐部正式成立！欢迎华盛顿州与大西雅图地区广大热爱高尔夫运动的高校校友、亲友及爱好者前来共建，扫码加入微信群交流。",
    link: "/posts/2026-08-27-golf-club-announcement/"
  },
  {
    title: "【重磅】北美高校联盟华盛顿州分会设立特色主题俱乐部（全面升级独立 URI 路径）",
    date: "2026年8月19日",
    rawDate: "2026-08-19",
    category: "重大公告",
    badgeType: "primary",
    summary: "北美高校联盟华盛顿州分会（西雅图分会）设立特色俱乐部：华盛顿州掼蛋俱乐部 (/guandan)、雷尼尔追风健行群 (/hike)、匹克球俱乐部 (/pickleball)、音乐玩乐群 (/music) 等，全面启用独立 URI 路径。",
    link: "/posts/2026-08-19-four-clubs-announcement/"
  },
  {
    title: "【赛事公告】首届北美华人AI音乐创作创意大赛 2026–2027 正式启动！",
    date: "2026年7月22日",
    rawDate: "2026-07-22",
    category: "赛事动态",
    badgeType: "emerald",
    summary: "庆祝浙江大学130周年华诞暨北卡浙大校友会成立15周年，由北美高校联盟北卡分会、南卡分会、华盛顿DC分会、南加州分会和AI创业公益俱乐部等机构联合主办的大赛启动报名！以AI为笔，谱写华人故事！",
    link: "/posts/2026-07-22-first-north-american-chinese-ai-music-competition/"
  }
];
---

<BaseLayout lang="zh-CN" title="联盟新闻与官方公告" description="北美高校联盟华盛顿州分会新闻中心、俱乐部成立资讯、赛事公告与重大发布。" path="/news/">
  <div class="max-w-5xl mx-auto px-6 py-12 md:py-20">
    <!-- Header Banner -->
    <div class="text-center mb-12 space-y-4">
      <div class="inline-flex items-center gap-x-2 px-3.5 py-1.5 rounded-full bg-blue-950/60 border border-blue-800/40 text-blue-400 text-xs font-semibold uppercase tracking-wider">
        <i class="fa-solid fa-bullhorn text-xs"></i>
        <span>新闻中心 · 官方动态</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-white tracking-tight heading-font">
        联盟新闻与重要发布
      </h1>
      <p class="text-slate-400 text-base max-w-2xl mx-auto">
        及时发布北美高校联盟华盛顿州分会（西雅图分会）重大决策、俱乐部共建进展、社区赛事与前沿合作资讯
      </p>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-10 border-b border-slate-800 pb-4">
      <button class="news-tab-btn active px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-blue-600 text-white" data-category="all">
        全部新闻 (All)
      </button>
      <button class="news-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-800" data-category="announcement">
        重大公告
      </button>
      <button class="news-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-800" data-category="club">
        俱乐部与赛事
      </button>
      <a href="/posts/" class="px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-slate-900/40 text-slate-400 hover:text-blue-400 hover:bg-slate-800 border border-slate-800/60 flex items-center gap-1.5">
        <span>切换至活动讲座</span>
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </a>
    </div>

    <!-- News List -->
    <div class="space-y-6" id="news-container">
      {newsItems.map(item => {
        const catKey = item.category.includes('俱乐部') || item.category.includes('赛事') ? 'club' : 'announcement';
        return (
          <article class="news-card bg-slate-900/60 border border-slate-800/80 hover:border-blue-500/40 rounded-3xl p-6 md:p-8 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-950/50 group" data-category={catKey}>
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
              <div class="space-y-3 flex-1">
                <div class="flex items-center gap-x-3 text-xs">
                  <span class:list={[
                    "px-3 py-1 rounded-full font-semibold border",
                    item.badgeType === "amber" ? "bg-amber-500/10 text-amber-400 border-amber-500/20" :
                    item.badgeType === "emerald" ? "bg-emerald-500/10 text-emerald-400 border-emerald-500/20" :
                    "bg-blue-600/10 text-blue-400 border-blue-500/20"
                  ]}>
                    {item.category}
                  </span>
                  <span class="text-slate-400 flex items-center gap-x-1">
                    <i class="fa-regular fa-calendar text-[11px]"></i>
                    <time datetime={item.rawDate}>{item.date}</time>
                  </span>
                </div>
                <h2 class="text-xl md:text-2xl font-bold text-white group-hover:text-blue-400 transition-colors leading-snug">
                  <a href={item.link}>{item.title}</a>
                </h2>
                <p class="text-slate-300 text-sm leading-relaxed">{item.summary}</p>
              </div>
              <a href={item.link} class="shrink-0 px-6 py-3 bg-slate-800 hover:bg-blue-600 text-slate-100 hover:text-white text-xs font-semibold rounded-2xl transition-all duration-200 text-center flex items-center justify-center gap-x-2 group-hover:bg-blue-600">
                <span>查看详情</span>
                <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <script>
    const tabs = document.querySelectorAll('.news-tab-btn');
    const cards = document.querySelectorAll('.news-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const cat = tab.getAttribute('data-category');
        tabs.forEach(t => {
          t.classList.remove('bg-blue-600', 'text-white', 'active');
          t.classList.add('bg-slate-900', 'text-slate-400');
        });
        tab.classList.remove('bg-slate-900', 'text-slate-400');
        tab.classList.add('bg-blue-600', 'text-white', 'active');

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            (card as HTMLElement).style.display = 'block';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
