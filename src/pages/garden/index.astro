---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh-CN" title="园艺团购俱乐部 | 北美高校联盟华盛顿州分会（西雅图分会） (NACUAA WA)" description="北美高校联盟华州西雅图园艺团购俱乐部（/garden），微信群：灣區園藝團購交流群。" path="/garden/">
  <div class="max-w-4xl mx-auto px-6 py-12 md:py-20 space-y-10">
    <!-- Breadcrumb & Director -->
    <div class="flex items-center justify-between flex-wrap gap-4">
      <a href="/clubs/" class="inline-flex items-center gap-x-2 text-xs text-blue-400 hover:text-blue-300 transition-colors">
        <i class="fa-solid fa-arrow-left"></i>
        <span>返回九大俱乐部总览</span>
      </a>
      <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-600/10 text-blue-400 border border-blue-500/20 flex items-center gap-x-1.5">
        <i class="fa-regular fa-user text-xs"></i>
        <span>分会会长：Ashley Qi (戚霄)</span>
      </span>
    </div>

    <!-- Hero Card -->
    <div class="relative bg-gradient-to-br from-lime-950/40 via-slate-900/80 to-slate-950 border border-lime-800/40 rounded-3xl p-8 md:p-10 shadow-2xl backdrop-blur-md overflow-hidden">
      <div class="absolute -right-10 -top-10 w-64 h-64 bg-lime-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="flex items-start gap-x-5">
        <div class="w-16 h-16 rounded-2xl bg-lime-600/20 text-lime-300 border border-lime-500/30 flex items-center justify-center text-3xl shrink-0 shadow-lg">
          🌱
        </div>
        <div class="space-y-2">
          <div class="text-xs text-lime-400 font-mono tracking-wider uppercase font-semibold">ALUMNI THEME CLUB #7</div>
          <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight heading-font">
            园艺团购俱乐部 <span class="text-lime-300 text-2xl font-light block sm:inline font-sans">Garden Club</span>
          </h1>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
            <span class="px-2.5 py-1 rounded-lg bg-slate-950/60 border border-slate-800 text-slate-300 font-mono">
              URI: wa.nacuaa.ai/garden
            </span>
            <span class="px-2.5 py-1 rounded-lg bg-lime-950/60 border border-lime-800/60 text-lime-300 font-mono">
              <i class="fa-brands fa-weixin mr-1"></i> 进群群名：灣區園藝團購交流群
            </span>
          </div>
        </div>
      </div>
      <p class="text-slate-300 text-sm md:text-base leading-relaxed mt-6 border-t border-lime-900/30 pt-6">
        园艺团购俱乐部由北美高校联盟华盛顿州分会（西雅图分会）建立，微信群<strong>【灣區園藝團購交流群】</strong>汇聚了湾区广大绿色生活与园艺种植爱好者，定期交流果树栽培、花卉繁育、庭院打理及优质园艺苗木团购。
      </p>
    </div>

    <!-- Highlights -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-lime-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-lime-600/10 text-lime-400 flex items-center justify-center text-lg mb-4 border border-lime-500/20">
          <i class="fa-solid fa-leaf"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">加州果树与种植技巧</h3>
        <p class="text-xs text-slate-400 leading-relaxed">结合湾区气候微环境，交流柑橘、无花果、柿子等果树修剪施肥。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-lime-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-lime-600/10 text-lime-400 flex items-center justify-center text-lg mb-4 border border-lime-500/20">
          <i class="fa-solid fa-seedling"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">花友插扦与种子交换</h3>
        <p class="text-xs text-slate-400 leading-relaxed">定期组织花木枝条分享、多肉互换及自留菜种交流。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-lime-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-lime-600/10 text-lime-400 flex items-center justify-center text-lg mb-4 border border-lime-500/20">
          <i class="fa-solid fa-cart-shopping"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">原产地优质苗木团购</h3>
        <p class="text-xs text-slate-400 leading-relaxed">直达湾区及加州各大专业苗圃，组织团购精选花果品种与有机肥料。</p>
      </div>
    </div>

    <!-- Leadership / Contact Box -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-8 space-y-6">
      <h3 class="text-lg font-bold text-white border-l-4 border-lime-500 pl-3">📞 俱乐部负责人与入群联系</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-200">
        
        <div class="bg-slate-950/50 border border-slate-800 rounded-2xl p-4 space-y-1">
          <div class="font-bold text-white text-sm">Ashley Qi (戚霄)</div>
          <div class="text-slate-400">华盛顿州分会会长</div>
          <div class="flex flex-col gap-y-0.5">            <a href="mailto:ashley@nacuaa.ai" class="text-blue-400 hover:underline">ashley@nacuaa.ai</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
