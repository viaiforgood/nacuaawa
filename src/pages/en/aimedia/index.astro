---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="AI影音创意俱乐部 | 北美高校联盟Washington State Chapter (NACUAA WA) (NACUAA WA)" description="北美高校联盟Washington StateAI影音创意俱乐部（/aimedia），专注于AI视频生成、AI音频剪辑与多媒体创意（独立发展，不与音乐玩乐群合并）。" path="/en/aimedia/">
  <div class="max-w-4xl mx-auto px-6 py-12 md:py-20 space-y-10">
    <!-- Breadcrumb & Director -->
    <div class="flex items-center justify-between flex-wrap gap-4">
      <a href="/en/clubs/" class="inline-flex items-center gap-x-2 text-xs text-blue-400 hover:text-blue-300 transition-colors">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to 9 Clubs Directory</span>
      </a>
      <a href="mailto:tracy@wa.nacuaa.ai" class="px-3 py-1 rounded-full text-xs font-medium bg-blue-600/10 text-blue-400 border border-blue-500/20 hover:border-blue-400 transition-colors flex items-center gap-x-1.5">
        <i class="fa-regular fa-user text-xs"></i>
        <span>President: Ashley Qi (戚霄)</span>
      </a>
    </div>

    <!-- Hero Card -->
    <div class="relative bg-gradient-to-br from-indigo-950/40 via-slate-900/80 to-slate-950 border border-indigo-800/40 rounded-3xl p-8 md:p-10 shadow-2xl backdrop-blur-md overflow-hidden">
      <div class="absolute -right-10 -top-10 w-64 h-64 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="flex items-start gap-x-5">
        <div class="w-16 h-16 rounded-2xl bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 flex items-center justify-center text-3xl shrink-0 shadow-lg">
          🎬
        </div>
        <div class="space-y-2">
          <div class="text-xs text-indigo-400 font-mono tracking-wider uppercase font-semibold">ALUMNI THEME CLUB #9</div>
          <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight heading-font">
            AI影音创意俱乐部 <span class="text-indigo-300 text-2xl font-light block sm:inline font-sans">AI Creative Media Club</span>
          </h1>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
            <span class="px-2.5 py-1 rounded-lg bg-slate-950/60 border border-slate-800 text-slate-300 font-mono">
              URI: wa.nacuaa.ai/aimedia
            </span>
            <span class="px-2.5 py-1 rounded-lg bg-indigo-950/60 border border-indigo-800/60 text-indigo-300 font-mono">
              <i class="fa-brands fa-weixin mr-1"></i> 进群群名：AI影音创意俱乐部
            </span>
          </div>
        </div>
      </div>
      <p class="text-slate-300 text-sm md:text-base leading-relaxed mt-6 border-t border-indigo-900/30 pt-6">
        Washington StateAI影音创意俱乐部由北美高校联盟Washington State Chapter (NACUAA WA)建立，<strong>独立发展，不和音乐玩乐群合并</strong>。俱乐部专注于前沿生成式AI在视频创作、音频合成、数字人、特效及创意新媒体领域的探索与实践。
      </p>
    </div>

    <!-- Highlights -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-indigo-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-indigo-600/10 text-indigo-400 flex items-center justify-center text-lg mb-4 border border-indigo-500/20">
          <i class="fa-solid fa-film"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">AI 视频与视觉创作</h3>
        <p class="text-xs text-slate-400 leading-relaxed">探索Sora、Runway、Pika、Kling等最新生成模型的工作流与提示词技巧。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-indigo-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-indigo-600/10 text-indigo-400 flex items-center justify-center text-lg mb-4 border border-indigo-500/20">
          <i class="fa-solid fa-user-astronaut"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">多模态数字人与配音</h3>
        <p class="text-xs text-slate-400 leading-relaxed">构建多语言数字人主播、声音克隆与智能视频本地化全流程方案。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-indigo-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-indigo-600/10 text-indigo-400 flex items-center justify-center text-lg mb-4 border border-indigo-500/20">
          <i class="fa-solid fa-bullhorn"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">自媒体IP与出海赋能</h3>
        <p class="text-xs text-slate-400 leading-relaxed">赋能校友自媒体内容创作、短视频矩阵建设与企业全球化传播。</p>
      </div>
    </div>

    <!-- Leadership / Contact Box -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-8 space-y-6">
      <h3 class="text-lg font-bold text-white border-l-4 border-indigo-500 pl-3">📞 俱乐部负责人与入群联系</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-200">
        
        <div class="bg-slate-950/50 border border-slate-800 rounded-2xl p-4 space-y-1">
          <div class="font-bold text-white text-sm">Xiaoyan Wan</div>
          <div class="text-slate-400">媒体与传播委员会主席 / 设计总监</div>
          
        </div>
        <div class="bg-slate-950/50 border border-slate-800 rounded-2xl p-4 space-y-1">
          <div class="font-bold text-white text-sm">Ashley Qi (戚霄)</div>
          <div class="text-slate-400">Chapter President</div>
          <div class="flex flex-col gap-y-0.5">            <a href="mailto:ashley@nacuaa.ai" class="text-blue-400 hover:underline">ashley@nacuaa.ai</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
