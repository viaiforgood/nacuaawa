---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="Silicon Valley Closed-Door AI Forum (Hybrid) | Keynote by Dr. Yufeng Lu | NACUAA Washington State Chapter (NACUAA WA)" description="Closed-door. RSVP first and choose Silicon Valley onsite or Zoom. Keynote by Dr. Yufeng Lu with invited guests. Topics include AI-native professional services, physical AI & agent safety, and cross-border tech ventures." path="/en/posts/2026-10-05-silicon-valley-closed-door-ai-forum/">
  <div class="max-w-3xl mx-auto px-6 py-12 md:py-20">
    <a href="/en/posts/" class="inline-flex items-center gap-x-2 text-sm text-purple-400 hover:text-purple-300 mb-8 transition-colors">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Events</span>
    </a>

    <article class="space-y-8">
      <header class="border-b border-slate-900 pb-8 space-y-4">
        <div class="flex items-center gap-x-3 text-xs text-slate-500 mb-2">
          <time datetime="2026-09-24">Sep 24, 2026</time>
          <span>·</span>
          <span class="px-2.5 py-0.5 rounded-full bg-purple-600/10 text-purple-400 border border-purple-500/20 font-semibold">Closed-Door Forum</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-white leading-tight">
          Silicon Valley Closed-Door AI Forum (Hybrid) | Keynote by Dr. Yufeng Lu
        </h1>
        <p class="text-base text-purple-400 font-medium">
          Co-hosted and forwarded by NACUAA Washington State Chapter.
        </p>
      </header>

      <!-- Event Time & Venue Card -->
      <div class="p-6 md:p-8 bg-gradient-to-br from-purple-950/40 via-slate-900 to-blue-950/40 border border-purple-500/30 rounded-3xl space-y-6 shadow-2xl">
        <div class="space-y-3">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-calendar-days text-purple-400"></i>
            <span>Event Time & Venue</span>
          </h3>
          <div class="grid sm:grid-cols-3 gap-3 text-xs text-slate-300">
            <div class="p-3 rounded-xl bg-slate-950/50 border border-slate-800">
              <span class="text-slate-500 block font-medium">Pacific Time (PDT)</span>
              <span class="text-white font-semibold text-sm mt-1 block">Mon 5 Oct 2026, 5:00–6:30 PM PDT</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-950/50 border border-slate-800">
              <span class="text-slate-500 block font-medium">Eastern Time (EDT)</span>
              <span class="text-white font-semibold text-sm mt-1 block">Mon 5 Oct 2026, 8:00–9:30 PM EDT</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-950/50 border border-slate-800">
              <span class="text-slate-500 block font-medium">Beijing Time</span>
              <span class="text-white font-semibold text-sm mt-1 block">Tue 6 Oct 2026, 8:00–9:30 AM</span>
            </div>
          </div>
          
          <div class="space-y-2 pt-1 text-xs text-slate-300">
            <div class="p-3 rounded-xl bg-slate-950/50 border border-slate-800 flex items-start gap-2">
              <i class="fa-solid fa-location-dot text-amber-400 mt-0.5"></i>
              <div>
                <span><strong>Onsite Venue:</strong> Silicon Valley · Milpitas | California Science and Technology University (1601 McCarthy Boulevard, Milpitas, CA 95035)</span>
              </div>
            </div>
            <div class="p-3 rounded-xl bg-blue-950/40 border border-blue-800/60 flex items-start gap-2">
              <i class="fa-solid fa-video text-blue-400 mt-0.5"></i>
              <div>
                <span><strong>Online Meeting:</strong> Zoom (Zoom link will be in your Luma confirmation email after approval)</span>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-2 flex flex-wrap gap-4">
          <a href="https://luma.com/lcmrs31v" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-purple-600 hover:bg-purple-500 text-white font-semibold text-sm rounded-xl transition-all shadow-lg flex items-center gap-2">
            <i class="fa-solid fa-ticket"></i>
            <span>RSVP on Luma</span>
          </a>
          <a href="https://zjuaanc.org/posts/2026-10-05-silicon-valley-closed-door-ai-forum/" target="_blank" rel="noopener noreferrer" class="px-5 py-3 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm rounded-xl transition-all border border-slate-700 flex items-center gap-2">
            <i class="fa-solid fa-newspaper"></i>
            <span>ZJUAANC Announcement</span>
          </a>
        </div>
      </div>

      <div class="text-slate-300 space-y-6 leading-relaxed text-base">
        <div class="p-4 rounded-xl bg-amber-900/20 border border-amber-500/30 text-amber-200 space-y-1 text-sm">
          <p class="font-semibold text-white">Closed-door. RSVP first and choose Silicon Valley onsite or Zoom.</p>
          <p>Please select <strong>Attend in person</strong> or <strong>Attend online</strong> on Luma. Limited capacity.</p>
        </div>

        <p>
          Hybrid forum in Silicon Valley. First hour: talks. Last 30 minutes: Q&A. Keynote by Dr. Yufeng Lu with invited guests. Topics: AI-native professional services, regional differences, physical AI and agents with security and compliance, nonprofit AI entrepreneurship, and cross-border e-commerce going global.
        </p>

        <!-- Agenda -->
        <div class="space-y-3">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-clock text-purple-400"></i>
            <span>Agenda</span>
          </h3>
          <ul class="space-y-2 text-sm text-slate-300 pl-2">
            <li class="flex items-start gap-2">
              <span class="font-mono text-purple-400 font-semibold min-w-[75px]">5:00–6:00</span>
              <span>Keynote & guest presentations (Dr. Yufeng Lu & invited guests)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-mono text-amber-400 font-semibold min-w-[75px]">6:00–6:30</span>
              <span>Closed-door Q&A and discussion</span>
            </li>
          </ul>
        </div>

        <!-- Guests -->
        <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-4 text-sm">
          <h4 class="font-bold text-white flex items-center gap-2 text-base">
            <i class="fa-solid fa-users text-purple-400"></i>
            <span>Invited Guest Speakers</span>
          </h4>
          <ol class="space-y-3 text-slate-300 leading-relaxed list-decimal list-inside">
            <li>
              <strong>Dr. Yufeng Lu</strong> — Founder and CEO, Rogue / Loge Tech Group<br/>
              <span class="text-slate-400 text-xs ml-5 block">Enterprise AI, LLMs, data intelligence & AI deployment</span>
            </li>
            <li>
              <strong>Xuepeng Liu</strong> — CTO<br/>
              <span class="text-slate-400 text-xs ml-5 block">AI architecture, engineering & enterprise AI applications</span>
            </li>
            <li>
              <strong>Xia Li</strong> — Senior Director, Intel<br/>
              <span class="text-slate-400 text-xs ml-5 block">Advanced semiconductors, AI silicon, advanced nodes & Physical AI hardware</span>
            </li>
            <li>
              <strong>Dr. Zhenyu Liao</strong> — Amazon<br/>
              <span class="text-slate-400 text-xs ml-5 block">VLM Reinforcement Learning & post-training, reasoning & decision-making</span>
            </li>
            <li>
              <strong>Dr. Glen Qin (Zhigang Qin)</strong> — President, CSTU<br/>
              <span class="text-slate-400 text-xs ml-5 block">Tsinghua B.S., UC Berkeley Ph.D.; Silicon Valley engineering & AI education</span>
            </li>
          </ol>
        </div>

        <!-- Speaker Bio -->
        <div class="p-6 rounded-2xl bg-gradient-to-br from-indigo-950/20 via-slate-900 to-slate-900 border border-indigo-500/30 space-y-3">
          <h4 class="font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-user-tie text-indigo-400"></i>
            <span>Keynote Speaker Bio: Dr. Yufeng Lu</span>
          </h4>
          <p class="text-sm text-slate-300 leading-relaxed">
            Zhejiang University B.S., Renmin University Ph.D., postdoc at Tsinghua Institute for Contemporary China Studies. Former Chief Architect of the Golden Tax Phase III project (total investment exceeding 20 billion RMB). Founder and Chairman of Rogue / Loge Tech Group, which is transitioning from a tax big-data pioneer to a leading domestic infrastructure provider of AI-native professional services.
          </p>
        </div>

        <!-- Contact Info -->
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2 text-sm">
          <p class="font-semibold text-white">Inquiries & Contact</p>
          <p class="text-slate-300">Michael HUO</p>
          <ul class="space-y-1 text-slate-400 text-xs">
            <li>• WeChat: michaelhuo</li>
            <li>• Email: michael@vi.team | michael@zjuaanc.org | michael@nacuaa.ai</li>
          </ul>
        </div>

        <!-- Core Links -->
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2 text-sm">
          <p class="font-semibold text-white">Related Links & RSVP</p>
          <ul class="space-y-1.5 text-slate-300">
            <li>• Luma RSVP: <a href="https://luma.com/lcmrs31v" target="_blank" rel="noopener noreferrer" class="text-purple-400 hover:underline font-semibold">https://luma.com/lcmrs31v</a> (Choose Attend in person or Attend online)</li>
            <li>• ZJUAANC Post: <a href="https://zjuaanc.org/posts/2026-10-05-silicon-valley-closed-door-ai-forum/" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">zjuaanc.org Announcement</a></li>
          </ul>
        </div>

        <p class="text-xs text-slate-400 italic">
          Closed-door forum. Zoom link provided upon approved RSVP.
        </p>

        <div class="border-t border-slate-900 pt-6 mt-8 space-y-2 text-xs text-slate-400">
          <h4 class="font-semibold text-slate-300">Hosts & Partners</h4>
          <p><strong>Hosts:</strong> NACUAA Northern California and Silicon Valley Chapters, jointly with North Carolina, DC, and Washington Chapters; ZJUAANC and sister ZJU alumni associations (Tennessee, Philadelphia, Florida, Rhode Island); VI AI Foundation and VI AI for Good Foundation</p>
          <p><strong>Media Partner:</strong> 华人头条 (Chinese Headline New Media)</p>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
