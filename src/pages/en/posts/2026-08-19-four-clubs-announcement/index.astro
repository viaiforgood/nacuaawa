---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="NACUAA NorCal & Washington DC Chapters Launch Four Major Clubs" description="NACUAA NorCal and Washington DC Chapters jointly establish four clubs: Guandan, Hike/Outdoor, Pickleball, and AI Music/Fun, using direct URI paths." path="/en/posts/2026-08-19-four-clubs-announcement/">
  <div class="max-w-3xl mx-auto px-6 py-12 md:py-20">
    <a href="/en/" class="inline-flex items-center gap-x-2 text-sm text-blue-500 hover:text-blue-400 mb-8 transition-colors">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Home</span>
    </a>

    <article class="space-y-8">
      <header class="border-b border-slate-900 pb-8 space-y-4">
        <div class="flex items-center gap-x-3 text-xs text-slate-500 mb-2">
          <time datetime="2026-08-19">August 19, 2026</time>
          <span>·</span>
          <span class="px-2.5 py-0.5 rounded-full bg-blue-600/10 text-blue-400 border border-blue-500/20 font-semibold">Announcement</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-white leading-tight">
          🎉 NACUAA NorCal & Washington DC Chapters Formally Launch Four Major Clubs
        </h1>
        <p class="text-xs text-slate-400">
          Co-Organized by NACUAA NorCal & Washington DC Chapters
        </p>
      </header>

      <div class="text-slate-300 space-y-6 leading-relaxed text-base">
        <p class="text-lg text-slate-200 font-medium">
          Dear Alumni & Friends,
        </p>
        <p>
          To enrich community life across the San Francisco Bay Area, Silicon Valley, and Northern California, <strong>NACUAA NorCal & Washington DC Chapters have jointly launched four interest-based clubs</strong>!
        </p>
        <p>
          All clubs now feature direct **URI paths** for intuitive access:
        </p>

        <!-- Clubs List -->
        <div class="space-y-4 my-6">
          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🎴 Guandan Card Game Club</h3>
              <p class="text-xs text-slate-400">Card tournaments & social networking.</p>
            </div>
            <a href="/guandan/" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit dc.nacuaa.ai/guandan
            </a>
          </div>

          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🥾 Hike & Outdoor Group</h3>
              <p class="text-xs text-slate-400">Weekend trail hikes, state park trips & outdoor activities.</p>
            </div>
            <a href="/en/hike/" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit dc.nacuaa.ai/en/hike
            </a>
          </div>

          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🏓 Pickleball Club</h3>
              <p class="text-xs text-slate-400">Pickleball sessions, coaching & matches.</p>
            </div>
            <a href="/pickleball/" class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit dc.nacuaa.ai/pickleball
            </a>
          </div>

          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🎵 AI Music & Fun Group</h3>
              <p class="text-xs text-slate-400">AI music creation, vocal performance & jams.</p>
            </div>
            <a href="/music/" class="px-4 py-2 bg-pink-600 hover:bg-pink-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit dc.nacuaa.ai/music
            </a>
          </div>
        </div>

        <h3 class="text-lg font-bold text-white border-l-4 border-blue-500 pl-3">📞 Contacts</h3>
        <ul class="space-y-2 text-sm text-slate-200 bg-slate-900/60 border border-slate-800 p-5 rounded-2xl">
          <li>· <strong>Jerry Zhang (张锐)</strong> - President, NACUAA NorCal Chapter</li>
          <li>· <strong>刘斌 (Bin Liu)</strong> - President, NACUAA Washington DC Chapter</li>
          <li>· <strong>Rose Li (Rose)</strong> - President, ZJUAANC</li>
          <li>· <strong>刘斌 (Bin Liu) (Michael)</strong> - Chair, AI Club & President, NorCal Chapter</li>
        </ul>

        <div class="pt-4 text-center">
          <a href="/clubs/" class="px-6 py-3 bg-slate-800 hover:bg-slate-700 text-white font-semibold text-sm rounded-2xl transition-colors inline-block">
            View All Clubs (/clubs/)
          </a>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
