---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout 
  lang="en" 
  title="NACUAA Washington State (Seattle) Chapter Establishes Signature Clubs with Direct URI Paths" 
  description="NACUAA Washington State Chapter establishes nine signature clubs: Guandan, Rainier Hiking, Pickleball, Golf, Tennis, Music, Gardening, AI Venture, and AI Media." 
  path="/en/posts/2026-08-19-four-clubs-announcement/"
>
  <div class="max-w-3xl mx-auto px-6 py-12 md:py-20">
    <a href="/en/" class="inline-flex items-center gap-x-2 text-sm text-blue-500 hover:text-blue-400 mb-8 transition-colors">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Home</span>
    </a>

    <article class="space-y-8">
      <header class="border-b border-slate-900 pb-8 space-y-4">
        <div class="flex items-center gap-x-3 text-xs text-slate-500 mb-2">
          <time datetime="2026-08-19">August 19, 2026</time>
          <span>·</span>
          <span class="px-2.5 py-0.5 rounded-full bg-blue-600/10 text-blue-400 border border-blue-500/20 font-semibold">Announcement</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-white leading-tight">
          🎉 NACUAA Washington State (Seattle) Chapter Establishes Signature Clubs
        </h1>
        <p class="text-xs text-slate-400">
          Organized by NACUAA Washington State (Seattle) Chapter
        </p>
      </header>

      <div class="text-slate-300 space-y-6 leading-relaxed text-base">
        <p class="text-lg text-slate-200 font-medium">
          Dear Alumni & Friends in Greater Seattle and Washington State,
        </p>
        <p>
          To enrich the community life and well-being of collegiate alumni across the Pacific Northwest, <strong>NACUAA Washington State (Seattle) Chapter</strong> has established signature thematic clubs!
        </p>
        <p>
          All clubs feature direct <strong>URI paths</strong> for clean and intuitive access:
        </p>

        <!-- Clubs List -->
        <div class="space-y-4 my-6">
          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🎴 Guandan Card Game Club</h3>
              <p class="text-xs text-slate-400">Card tournaments & social networking.</p>
            </div>
            <a href="/en/guandan/" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit wa.nacuaa.ai/guandan
            </a>
          </div>

          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🥾 Rainier Hiking & Outdoor Group</h3>
              <p class="text-xs text-slate-400">Weekend trail hikes, Mount Rainier excursions & PNW national park exploration.</p>
            </div>
            <a href="/en/hike/" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit wa.nacuaa.ai/hike
            </a>
          </div>

          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🏓 Pickleball Club</h3>
              <p class="text-xs text-slate-400">Pickleball open sessions, coaching & tournament matches.</p>
            </div>
            <a href="/en/pickleball/" class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit wa.nacuaa.ai/pickleball
            </a>
          </div>

          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">⛳ Green Golf Club</h3>
              <p class="text-xs text-slate-400">Alumni golf outings across premier Washington State courses.</p>
            </div>
            <a href="/en/golf/" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit wa.nacuaa.ai/golf
            </a>
          </div>

          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🎾 Excellence Tennis Club</h3>
              <p class="text-xs text-slate-400">Singles & doubles match play, clinics, and drills.</p>
            </div>
            <a href="/en/tennis/" class="px-4 py-2 bg-lime-600 hover:bg-lime-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit wa.nacuaa.ai/tennis
            </a>
          </div>

          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🎵 AI Music & Fun Group / VI AI Music</h3>
              <p class="text-xs text-slate-400">AI songwriting, vocal jam sessions & recitals.</p>
            </div>
            <a href="/en/music/" class="px-4 py-2 bg-pink-600 hover:bg-pink-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit wa.nacuaa.ai/music
            </a>
          </div>

          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🌱 Green Home Gardening Club</h3>
              <p class="text-xs text-slate-400">Organic gardening, PNW fruit tree care, seed & plant swaps.</p>
            </div>
            <a href="/en/garden/" class="px-4 py-2 bg-teal-600 hover:bg-teal-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit wa.nacuaa.ai/garden
            </a>
          </div>

          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🤖 AI Venture Club</h3>
              <p class="text-xs text-slate-400">AI agents seminars, hackathons, and startup mentoring.</p>
            </div>
            <a href="/en/ai/" class="px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit wa.nacuaa.ai/ai
            </a>
          </div>

          <div class="p-5 bg-slate-900/80 border border-slate-800 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white mb-1">🎬 AI Media Studio</h3>
              <p class="text-xs text-slate-400">Generative video, digital avatars & multimedia production.</p>
            </div>
            <a href="/en/aimedia/" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs rounded-xl shrink-0 transition-colors">
              Visit wa.nacuaa.ai/aimedia
            </a>
          </div>
        </div>

        <h3 class="text-lg font-bold text-white border-l-4 border-blue-500 pl-3">📞 Leadership & Inquiries</h3>
        <ul class="space-y-2 text-sm text-slate-200 bg-slate-900/60 border border-slate-800 p-5 rounded-2xl">
          <li>· <strong>Ashley Qi (戚霄)</strong> - President, NACUAA Washington State Chapter (<a href="mailto:ashley@nacuaa.ai" class="text-blue-400 hover:underline">ashley@nacuaa.ai</a>)</li>
          <li>· <strong>Michael Huo</strong> - Chair, NACUAA AI Venture Club</li>
        </ul>

        <div class="pt-4 text-center">
          <a href="/en/clubs/" class="px-6 py-3 bg-slate-800 hover:bg-slate-700 text-white font-semibold text-sm rounded-2xl transition-colors inline-block">
            View All Clubs (/en/clubs/)
          </a>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
