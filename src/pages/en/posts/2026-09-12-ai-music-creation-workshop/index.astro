<BaseLayout lang="en" title="AI Music Workshop: Make Your First Song On the Spot | NACUAA Washington State Chapter (NACUAA WA)" description="Free Community Event. Onsite + Zoom. 60 min. Zero-to-one hands-on demo: create a complete song on the spot. No music theory lectures, no contest rule briefings." path="/en/posts/2026-09-12-ai-music-creation-workshop/">
  <div class="max-w-3xl mx-auto px-6 py-12 md:py-20">
    <a href="/en/posts/" class="inline-flex items-center gap-x-2 text-sm text-blue-500 hover:text-blue-400 mb-8 transition-colors">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Events</span>
    </a>

    <article class="space-y-8">
      <header class="border-b border-slate-900 pb-8 space-y-4">
        <div class="flex items-center gap-x-3 text-xs text-slate-500 mb-2">
          <time datetime="2026-09-12">Sep 12, 2026</time>
          <span>·</span>
          <span class="px-2.5 py-0.5 rounded-full bg-blue-600/10 text-blue-400 border border-blue-500/20 font-semibold">AI Workshop</span>
