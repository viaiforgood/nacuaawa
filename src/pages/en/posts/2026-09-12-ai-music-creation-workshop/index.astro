            <i class="fa-solid fa-calendar-days text-blue-400"></i>
            <span>Event Time & Venue</span>
          </h3>
          <div class="grid sm:grid-cols-2 gap-3 text-xs text-slate-300">
            <div class="p-3 rounded-xl bg-slate-950/50 border border-slate-800">
              <span class="text-slate-500 block font-medium">Pacific Time (PDT)</span>
