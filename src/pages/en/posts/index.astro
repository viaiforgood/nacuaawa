---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const posts = [
  {
    title: "[Major Announcement] NACUAA Washington State (Seattle) Chapter Officially Established! Ashley Qi Appointed President",
    date: "Sep 17, 2026",
    rawDate: "2026-09-17",
    category: "Announcement",
    summary: "On September 17, 2026, NACUAA Washington State (Seattle) Chapter was officially established with Ashley Qi appointed as its inaugural president. Serving collegiate alumni across Greater Seattle and Washington State with nine signature community clubs.",
    link: "/en/posts/2026-09-17-nacuaa-washington-state-chapter-established/"
  },
  {
    title: "[Major News] Four NACUAA Chapters Form Sister Chapter Alliance & Establish Strategic Partnership with ZJUAANC",
    date: "Sep 12, 2026",
    rawDate: "2026-09-12",
    category: "Major News",
    summary: "On September 12, 2026, NACUAA Northern California, Silicon Valley, North Carolina, and Greater Washington DC chapters officially forged a Sister Chapter Alliance. Concurrently, ZJUAANC established a comprehensive strategic partnership with all four chapters.",
    link: "/en/posts/2026-09-12-four-chapters-sisterhood-and-zju-strategic-partnership/"
  },

  {
    title: "[Free Community Webinar | Zoom] VI AI Music Academy #1: From Idea to a Song You Can Improve + RSI Now",
    date: "Sep 12, 2026",
    rawDate: "2026-09-12",
    category: "Events",
    summary: "Free Community Event. Zoom. 60 min. VI AI Music Academy Lecture #1. First half aligns with contest submission requirements. Second half covers the state of Recursive Self-Improvement (RSI) in LLMs and Agents.",
    link: "/en/posts/2026-09-12-vi-ai-music-academy-lecture-1-rsi/"
  },
  {
    title: "[Free Community Workshop | In-Person + Zoom] AI Music Workshop: Make Your First Song On the Spot",
    date: "Sep 12, 2026",
    rawDate: "2026-09-12",
    category: "Events",
    summary: "Free Community Event. Onsite + Zoom. 60 min. Zero-to-one hands-on demo: create a complete song on the spot. No music theory lectures, no contest rule briefings.",
    link: "/en/posts/2026-09-12-ai-music-creation-workshop/"
  },
  {
    title: "[Free Community Webinar | Zoom] AI-Native Agent Security & Compliance Part 1: From Chatting to Action, Where Do the Risks Come From?",
    date: "September 1, 2026",
    rawDate: "2026-09-01",
    category: "Webinar",
    summary: "Following Physical AI and Agent Media series, we launch AI-Native Agent Security & Compliance Part 1: Risk models, top 6 risk vectors, and pre-launch compliance checklists.",
    link: "/en/posts/2026-09-01-ai-native-agent-security-compliance-lecture-1/"
  },
  {
    title: "NACUAA Washington State (Seattle) Golf Club Officially Established",
    date: "August 27, 2026",
    rawDate: "2026-08-27",
    category: "Announcement",
    summary: "NACUAA Washington State (Seattle) Golf Club has been officially established! Welcome alumni and friends across Greater Seattle and Washington State to join.",
    link: "/en/posts/2026-08-27-golf-club-announcement/"
  },
  {
    title: "[Free Event | Zoom] Agentic Guandan (掼蛋) · Opening Workshop",
    date: "August 21, 2026",
    rawDate: "2026-08-21",
    category: "Lecture",
    summary: "Join us this Saturday noon for an 1-hour workshop on AI Agents & Guandan strategies, warming up for the 3rd NCCAF Guandan Tournament on August 29.",
    link: "/en/posts/2026-08-21-agentic-guandan-opening-class/"
  },
  {
    title: "NACUAA Washington State (Seattle) Chapter Establishes Signature Clubs with Direct URI Paths",
    date: "August 19, 2026",
    rawDate: "2026-08-19",
    category: "Announcement",
    summary: "NACUAA Washington State Chapter establishes signature clubs: Guandan (/guandan), Rainier Hiking (/hike), Pickleball (/pickleball), AI Music (/music), and more.",
    link: "/en/posts/2026-08-19-four-clubs-announcement/"
  },
  {
    title: "[Free Event | Zoom + YouTube] Zero-Foundation Software Agents: Mid-August 2026 Progress & Deployment Demo",
    date: "August 21, 2026",
    rawDate: "2026-08-21",
    category: "Lecture",
    summary: "ZJU AI Agent / AI Agent Alliance Lecture Series: Mid-August 2026 progress on software agents, featuring live cloud deployment demos of OpenClaw, Hermes, IronClaw, and comparative practice on NanoClaw, ZeroClaw, KimiClaw, Claude Cowork.",
    link: "/en/posts/2026-08-18-software-agents-august-2026-progress-and-deployment-demo/"
  },
  {
    title: "[Free Event | Zoom + YouTube] My AI and Me ~ Entrepreneurship Journey Session 2 & 'When New Media Meets AI Agents' Fireside Chat",
    date: "August 13, 2026",
    rawDate: "2026-08-13",
    category: "Lecture",
    summary: "Following the first session of 'My AI and Me' and the 'New Media Meets AI Agents' series, we present an interactive fireside chat featuring practitioners in AI music, video creation, and AI agent workflows.",
    link: "/en/posts/2026-08-13-my-ai-and-me-entrepreneurship-second-fireside-chat/"
  },
  {
    title: "【Free Public Lecture | Zoom】Embodied Intelligence & Physical AI Lecture 3: Getting Started with StackChan + Loop Engineering to Graph Engineering",
    date: "July 23, 2026",
    rawDate: "2026-07-23",
    category: "Lecture",
    summary: "Lecture 3 focuses on hands-on practice using open-source desktop robot StackChan, helping beginners learn the engineering shift from Loop to Graph Engineering.",
    link: "/en/posts/2026-07-23-embodied-intelligence-physical-ai-third-lecture/"
  },
  {
    title: "【Competition Notice】1st North American Chinese AI Music Creative Competition 2026–2027 Officially Launches!",
    date: "July 22, 2026",
    rawDate: "2026-07-22",
    category: "Competition",
    summary: "Celebrating ZJU's 130th and ZJUAA NC's 15th anniversaries, this event is co-organized by NACUAA chapters and AI clubs. Registration is now open!",
    link: "/en/posts/2026-07-22-first-north-american-chinese-ai-music-competition/"
  },
  {
    title: "【Free Public Lecture | Zoom】Embodied Intelligence & Physical AI Lecture 2: Paradigm Evolution from VLA to World Models",
    date: "July 10, 2026",
    rawDate: "2026-07-10",
    category: "Lecture",
    summary: "Exploring why traditional VLA hits bottlenecks, what World Models change, and real-world industrial impact in 2026. Slides and video recordings released.",
    link: "/en/posts/2026-07-10-embodied-intelligence-physical-ai-second-lecture/"
  },
  {
    title: "【Free Public Lecture | Zoom】40-Year Tech Veteran's Guide: How AI Agents Help Content Creators Make Real Money",
    date: "July 8, 2026",
    rawDate: "2026-07-08",
    category: "Lecture",
    summary: "Join veteran speaker Peter Wu as he shares how content creators can leverage AI Agents to build sustainable business systems.",
    link: "/en/posts/2026-07-08-ai-agents-entrepreneurship-club-lecture/"
