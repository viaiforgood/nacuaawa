---

<BaseLayout lang="en" title="News & Events Announcements" description="Latest events, academic lectures, and official announcements from NACUAA WA." path="/en/posts/">
  <div class="max-w-5xl mx-auto px-6 py-12 md:py-20">
    <!-- Header Banner -->
    <div class="text-center mb-16 space-y-4">
      <div class="inline-flex items-center gap-x-2 px-3.5 py-1.5 rounded-full bg-blue-950/60 border border-blue-800/40 text-blue-400 text-xs font-semibold uppercase tracking-wider">
        <i class="fa-solid fa-newspaper text-xs"></i>
        <span>News & Announcements</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold text-white tracking-tight heading-font">
        Latest Events & Community News
      </h1>
      <p class="text-slate-400 text-base max-w-2xl mx-auto">
        Stay updated with NACUAA WA's latest events, AI lectures, competition announcements, and official notices.
      </p>
    </div>

    <!-- Category Tabs -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-10 border-b border-slate-800 pb-4">
      <button class="post-tab-btn active px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-blue-600 text-white" data-filter="all">
        All Updates
      </button>
      <button class="post-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-800" data-filter="event">
        Events & Lectures
      </button>
      <button class="post-tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-800" data-filter="news">
        News & Announcements
      </button>
      <a href="/en/news/" class="px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-slate-900/40 text-slate-400 hover:text-blue-400 hover:bg-slate-800 border border-slate-800/60 flex items-center gap-1.5">
        <span>Go to News Center</span>
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </a>
    </div>

    <!-- Posts List -->
    <div class="space-y-6" id="posts-container">
      {posts.map(post => {
        const isNews = post.category === "Announcement" || post.category === "Competition" || post.category.includes("Club");
        return (
          <article class="post-card bg-slate-900/60 border border-slate-800/80 hover:border-blue-500/40 rounded-3xl p-6 md:p-8 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-950/50 group" data-category={post.category}>
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
              <div class="space-y-3 flex-1">
                <div class="flex items-center gap-x-3 text-xs">
                  <span class:list={[
                    "px-3 py-1 rounded-full font-semibold border",
                    isNews ? "bg-amber-500/10 text-amber-400 border-amber-500/20" : "bg-blue-600/10 text-blue-400 border-blue-500/20"
                  ]}>
                    {post.category}
                  </span>
                  <span class="text-slate-400 flex items-center gap-x-1">
                    <i class="fa-regular fa-calendar text-[11px]"></i>
                    <time datetime={post.rawDate}>{post.date}</time>
                  </span>
                </div>
                <h2 class="text-xl md:text-2xl font-bold text-white group-hover:text-blue-400 transition-colors leading-snug">
                  <a href={post.link}>{post.title}</a>
                </h2>
                <p class="text-slate-300 text-sm leading-relaxed">{post.summary}</p>
              </div>
              <a href={post.link} class="shrink-0 px-6 py-3 bg-slate-800 hover:bg-blue-600 text-slate-100 hover:text-white text-xs font-semibold rounded-2xl transition-all duration-200 text-center flex items-center justify-center gap-x-2 group-hover:bg-blue-600">
                <span>Read Article</span>
                <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <script>
    const tabs = document.querySelectorAll('.post-tab-btn');
    const articles = document.querySelectorAll('.post-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');
        tabs.forEach(t => {
          t.classList.remove('bg-blue-600', 'text-white', 'active');
          t.classList.add('bg-slate-900', 'text-slate-400');
        });
        tab.classList.remove('bg-slate-900', 'text-slate-400');
        tab.classList.add('bg-blue-600', 'text-white', 'active');

        articles.forEach(art => {
          const cat = art.getAttribute('data-category') || '';
          const isNews = cat === 'Announcement' || cat === 'Competition' || cat.includes('Club');
          const isEvent = cat === 'Webinar' || cat === 'Lecture';
          if (filter === 'all' || (filter === 'news' && isNews) || (filter === 'event' && isEvent)) {
            (art as HTMLElement).style.display = 'block';
          } else {
            (art as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
