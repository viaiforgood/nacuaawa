---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { CLUBS_DATA } from '../../../data/clubs';

const title = 'Alumni Clubs Directory | NACUAA WA';
const description = 'Official directory of the 9 alumni clubs organized by the North America Colleges and Universities Alumni Alliance, Washington State Chapter (Seattle).';
---

<BaseLayout lang="en" title={title} description={description} path="/en/clubs/">
  <div class="max-w-5xl mx-auto px-6 py-12 md:py-20">
    <!-- Header -->
    <header class="border-b border-slate-900 pb-8 mb-10 text-center md:text-left">
      <div class="inline-flex items-center gap-x-2 px-3 py-1 rounded-full bg-blue-600/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>CLUBS DIRECTORY</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-white leading-tight mb-4 heading-font">
        🏆 9 Alumni Theme Clubs
      </h1>
      <p class="text-slate-300 text-base md:text-lg leading-relaxed max-w-3xl">
        To enrich the lives of university alumni and friends across Greater Seattle and Washington State, NACUAA WA operates 9 theme clubs. <strong>Official club names are used externally, while existing WeChat group names are used for joining groups</strong>.
      </p>
    </header>

    <!-- Clubs Grid (9 Clubs) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {CLUBS_DATA.map((club, idx) => (
        <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 flex flex-col justify-between hover:border-blue-500/40 hover:bg-slate-900/70 transition-all duration-300 group shadow-xl">
          <div>
            <!-- Top Bar: Icon + Director Badge -->
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-2xl bg-slate-800 text-2xl flex items-center justify-center border border-slate-700 shadow-inner group-hover:scale-105 transition-transform">
                <span>{club.emoji}</span>
              </div>
              <a href={`mailto:${club.directorEmail}`} class="px-2.5 py-1 rounded-full text-[11px] font-medium bg-blue-600/10 text-blue-400 border border-blue-500/20 hover:border-blue-400 transition-colors flex items-center gap-x-1">
                <i class="fa-regular fa-user text-[10px]"></i>
                <span>{club.directorEn}</span>
              </a>
            </div>

            <!-- Club Names -->
            <div class="mb-3">
              <div class="text-xs text-slate-400 font-mono">#{idx + 1} Official Club Name</div>
              <h2 class="text-xl font-bold text-white group-hover:text-blue-400 transition-colors leading-snug">
                {club.nameEn}
              </h2>
              <div class="text-xs text-slate-400 font-medium">{club.nameZh}</div>
            </div>

            <!-- WeChat Group Name Box -->
            <div class="bg-slate-950/60 border border-slate-800/80 rounded-xl p-3 mb-4">
              <div class="text-[11px] text-slate-400 mb-0.5 flex items-center gap-x-1">
                <i class="fa-brands fa-weixin text-emerald-400"></i>
                <span>WeChat Group Name:</span>
              </div>
              <div class="text-xs font-semibold text-slate-200 font-mono">
                {club.groupNameZh}
              </div>
            </div>

            <!-- Description -->
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              {club.descEn}
            </p>

            {club.notesEn && (
              <div class="text-[11px] text-amber-300/90 bg-amber-500/10 border border-amber-500/20 rounded-lg px-2.5 py-1.5 mb-4">
                <i class="fa-solid fa-circle-info mr-1 text-[10px]"></i>
                <span>{club.notesEn}</span>
              </div>
            )}
          </div>

          <!-- CTA Button -->
          <div class="pt-4 border-t border-slate-800/80">
            <a href={club.route} class="w-full inline-flex items-center justify-center gap-x-2 text-center px-4 py-2.5 bg-blue-600/20 hover:bg-blue-600 text-blue-400 hover:text-white font-semibold text-xs rounded-xl border border-blue-500/20 hover:border-blue-500 transition-all duration-300">
              <span>View Club Details</span>
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Leadership / Contact / Join info -->
    <div class="bg-gradient-to-br from-slate-900/90 via-slate-900 to-blue-950/30 border border-slate-800 rounded-3xl p-8 space-y-6">
      <div class="flex items-center gap-x-3 mb-2">
        <div class="w-10 h-10 rounded-2xl bg-blue-600/10 text-blue-400 flex items-center justify-center border border-blue-500/20">
          <i class="fa-solid fa-users"></i>
        </div>
        <div>
          <h2 class="text-xl font-bold text-white">📞 Club Contacts & Inquiries</h2>
          <p class="text-xs text-slate-400">To join any of our clubs, please contact the leadership team:</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 text-xs text-slate-200 pt-2">
        <div class="bg-slate-950/50 border border-slate-800/80 rounded-2xl p-4 space-y-1.5">
          <div class="font-bold text-white text-sm">Ashley Qi (戚霄)</div>
          <div class="text-slate-400 text-[11px]">Chapter President</div>
          <div class="flex flex-col gap-y-0.5">
            <a href="mailto:ashley@nacuaa.ai" class="text-blue-400 hover:underline">ashley@nacuaa.ai</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
