---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="高尔夫俱乐部 | 北美高校联盟Washington State Chapter (NACUAA WA) (NACUAA WA)" description="北美高校联盟Washington State高尔夫俱乐部（/golf），组织旧金山湾区与硅谷高尔夫球友畅打、教学与赛事。" path="/en/golf/">
  <div class="max-w-4xl mx-auto px-6 py-12 md:py-20 space-y-10">
    <!-- Breadcrumb & Director -->
    <div class="flex items-center justify-between flex-wrap gap-4">
      <a href="/en/clubs/" class="inline-flex items-center gap-x-2 text-xs text-blue-400 hover:text-blue-300 transition-colors">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to 9 Clubs Directory</span>
      </a>
      <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-600/10 text-blue-400 border border-blue-500/20 flex items-center gap-x-1.5">
        <i class="fa-regular fa-user text-xs"></i>
        <span>President: Ashley Qi (戚霄)</span>
      </span>
    </div>

    <!-- Hero Card -->
    <div class="relative bg-gradient-to-br from-emerald-950/40 via-slate-900/80 to-slate-950 border border-emerald-800/40 rounded-3xl p-8 md:p-10 shadow-2xl backdrop-blur-md overflow-hidden">
      <div class="absolute -right-10 -top-10 w-64 h-64 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="flex items-start gap-x-5">
        <div class="w-16 h-16 rounded-2xl bg-emerald-600/20 text-emerald-300 border border-emerald-500/30 flex items-center justify-center text-3xl shrink-0 shadow-lg">
          🏌️‍♂️
        </div>
        <div class="space-y-2">
          <div class="text-xs text-emerald-400 font-mono tracking-wider uppercase font-semibold">ALUMNI THEME CLUB #4</div>
          <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight heading-font">
            高尔夫俱乐部 <span class="text-emerald-300 text-2xl font-light block sm:inline font-sans">Golf Club</span>
          </h1>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
            <span class="px-2.5 py-1 rounded-lg bg-slate-950/60 border border-slate-800 text-slate-300 font-mono">
              URI: wa.nacuaa.ai/golf
            </span>
            <span class="px-2.5 py-1 rounded-lg bg-emerald-950/60 border border-emerald-800/60 text-emerald-300 font-mono">
              <i class="fa-brands fa-weixin mr-1"></i> 进群群名：Washington State高尔夫俱乐部
            </span>
          </div>
        </div>
      </div>
      <p class="text-slate-300 text-sm md:text-base leading-relaxed mt-6 border-t border-emerald-900/30 pt-6">
        Washington State高尔夫俱乐部由北美高校联盟Washington State Chapter (NACUAA WA)与Washington State Chapter (NACUAA WA)联合建立，汇聚旧金山湾区与硅谷热爱高尔夫运动的高校校友与亲友，组织练习场交流、18洞球场打球与校友邀请赛。
      </p>
    </div>

    <!-- Highlights -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-emerald-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-emerald-600/10 text-emerald-400 flex items-center justify-center text-lg mb-4 border border-emerald-500/20">
          <i class="fa-solid fa-flag"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">18洞名场畅打</h3>
        <p class="text-xs text-slate-400 leading-relaxed">定期组织湾区与硅谷优美高尔夫球场下场体验，挥杆切磋。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-emerald-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-emerald-600/10 text-emerald-400 flex items-center justify-center text-lg mb-4 border border-emerald-500/20">
          <i class="fa-solid fa-crosshairs"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">练习场进阶沙龙</h3>
        <p class="text-xs text-slate-400 leading-relaxed">组织Topgolf及专业练习场挥杆解析、推杆技巧与球具交流。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-emerald-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-emerald-600/10 text-emerald-400 flex items-center justify-center text-lg mb-4 border border-emerald-500/20">
          <i class="fa-solid fa-trophy"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">高校高球邀请赛</h3>
        <p class="text-xs text-slate-400 leading-relaxed">筹办北加校友高尔夫联谊赛，设立总杆奖、净杆奖及最近洞奖。</p>
      </div>
    </div>

    <!-- WeChat QR Card -->
    <div class="text-center bg-slate-900/60 border border-slate-800 p-8 rounded-3xl space-y-4">
      <h3 class="text-lg font-bold text-white border-l-4 border-emerald-500 pl-3 text-left">📱 扫码加入微信交流群</h3>
      <p class="text-xs text-slate-300 text-left">
        欢迎感兴趣的校友前来共建。<em>（点击下方图片可查看完整大图）</em>
      </p>
      <div class="my-4 text-center">
        <a href="/images/golf_wechat_qr.jpg" target="_blank" rel="noopener noreferrer" class="inline-block group" title="点击查看完整大图 (Click for full size)">
          <img 
            src="/images/golf_wechat_qr.jpg" 
            alt="Washington State高尔夫俱乐部微信群二维码" 
            class="w-64 h-auto rounded-2xl border border-slate-700 shadow-2xl mx-auto group-hover:border-emerald-500 group-hover:scale-[1.02] transition-all duration-300"
          />
        </a>
        <p class="text-xs text-emerald-400 mt-3 font-medium">
          <i class="fa-solid fa-magnifying-glass-plus mr-1"></i> 点击二维码可放大查看完整大图 / 长按保存
        </p>
      </div>
    </div>

    <!-- Leadership / Contact Box -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-8 space-y-6">
      <h3 class="text-lg font-bold text-white border-l-4 border-emerald-500 pl-3">📞 俱乐部负责人与入群联系</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-200">
        
        <div class="bg-slate-950/50 border border-slate-800 rounded-2xl p-4 space-y-1">
          <div class="font-bold text-white text-sm">Ashley Qi (戚霄)</div>
          <div class="text-slate-400">Chapter President</div>
          <div class="flex flex-col gap-y-0.5">            <a href="mailto:ashley@nacuaa.ai" class="text-blue-400 hover:underline">ashley@nacuaa.ai</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
