---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="音乐玩乐俱乐部 | 北美高校联盟Washington State Chapter (NACUAA WA) (NACUAA WA)" description="北美高校联盟Washington State音乐玩乐俱乐部（/music），微信群：音乐玩乐群。主打卡拉OK、唱歌、聚会与音乐沙龙。" path="/en/music/">
  <div class="max-w-4xl mx-auto px-6 py-12 md:py-20 space-y-10">
    <!-- Breadcrumb & Director -->
    <div class="flex items-center justify-between flex-wrap gap-4">
      <a href="/en/clubs/" class="inline-flex items-center gap-x-2 text-xs text-blue-400 hover:text-blue-300 transition-colors">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to 9 Clubs Directory</span>
      </a>
      <span class="px-3 py-1 rounded-full text-xs font-medium bg-blue-600/10 text-blue-400 border border-blue-500/20 flex items-center gap-x-1.5">
        <i class="fa-regular fa-user text-xs"></i>
        <span>President: Ashley Qi (戚霄)</span>
      </span>
    </div>

    <!-- Hero Card -->
    <div class="relative bg-gradient-to-br from-pink-950/40 via-slate-900/80 to-slate-950 border border-pink-800/40 rounded-3xl p-8 md:p-10 shadow-2xl backdrop-blur-md overflow-hidden">
      <div class="absolute -right-10 -top-10 w-64 h-64 bg-pink-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="flex items-start gap-x-5">
        <div class="w-16 h-16 rounded-2xl bg-pink-600/20 text-pink-300 border border-pink-500/30 flex items-center justify-center text-3xl shrink-0 shadow-lg">
          🎵
        </div>
        <div class="space-y-2">
          <div class="text-xs text-pink-400 font-mono tracking-wider uppercase font-semibold">ALUMNI THEME CLUB #6</div>
          <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight heading-font">
            音乐玩乐俱乐部 <span class="text-pink-300 text-2xl font-light block sm:inline font-sans">Music Fun Club</span>
          </h1>
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
            <a href="https://chinesemusic.ai" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-x-1.5 px-3 py-1 rounded-lg bg-pink-600 hover:bg-pink-500 text-white font-medium text-xs shadow-md transition-colors">
              <i class="fa-solid fa-music text-[11px]"></i>
              <span>Visit Chinese AI Music Competition (chinesemusic.ai) →</span>
            </a>
            <span class="px-2.5 py-1 rounded-lg bg-pink-950/60 border border-pink-800/60 text-pink-300 font-mono">
              <i class="fa-brands fa-weixin mr-1"></i> 进群群名：音乐玩乐群
            </span>
          </div>
        </div>
      </div>
      <p class="text-slate-300 text-sm md:text-base leading-relaxed mt-6 border-t border-pink-900/30 pt-6">
        用音乐温暖生活！<strong>【音乐玩乐群】</strong>是Washington State高校校友的温馨音乐天地，<strong>主打卡拉 OK、唱歌、聚会、乐器交流与艺术沙龙</strong>，让每一位热爱音乐的校友在工作之余尽情释放灵感。
      </p>
    </div>

    <!-- Highlights -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-pink-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-pink-600/10 text-pink-400 flex items-center justify-center text-lg mb-4 border border-pink-500/20">
          <i class="fa-solid fa-microphone-lines"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">卡拉OK与歌友欢聚</h3>
        <p class="text-xs text-slate-400 leading-relaxed">定期组织南湾与东湾KTV聚会、线下开麦畅唱与流行歌曲合唱。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-pink-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-pink-600/10 text-pink-400 flex items-center justify-center text-lg mb-4 border border-pink-500/20">
          <i class="fa-solid fa-guitar"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">乐器演奏与沙龙</h3>
        <p class="text-xs text-slate-400 leading-relaxed">吉他、钢琴、小提琴、民乐等各类乐器爱好者切磋即兴Jam。</p>
      </div>

      <div class="bg-slate-900/50 border border-slate-800/80 rounded-3xl p-6 hover:border-pink-500/40 transition-all">
        <div class="w-10 h-10 rounded-xl bg-pink-600/10 text-pink-400 flex items-center justify-center text-lg mb-4 border border-pink-500/20">
          <i class="fa-solid fa-music"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-2">AI 音乐赛事协同</h3>
        <p class="text-xs text-slate-400 leading-relaxed">联合举办首届北美华人 AI 音乐创作大赛，赋能词曲创作者。</p>
      </div>
    </div>

    <!-- Related Post / Notification -->
    <div class="bg-slate-900/40 border border-slate-800/80 rounded-3xl p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-bold text-white flex items-center gap-x-2">
          <i class="fa-solid fa-bullhorn text-pink-400"></i>
          <span>音乐俱乐部重大赛事与活动</span>
        </h3>
        <span class="text-xs text-slate-400">赛事公告</span>
      </div>
      <a href="/posts/2026-07-22-first-north-american-chinese-ai-music-competition/" class="block p-4 bg-slate-950/60 border border-slate-800 rounded-2xl hover:border-pink-500/40 hover:bg-slate-950 transition-all group">
        <div class="text-xs text-pink-400 mb-1 font-semibold">2026年7月22日 · 赛事公告</div>
        <div class="text-sm font-bold text-white group-hover:text-pink-300 transition-colors mb-1">
          【赛事公告】首届北美华人AI音乐创作创意大赛 2026–2027 正式启动！ →
        </div>
        <p class="text-xs text-slate-400 line-clamp-2">由北美高校联盟Washington State Chapter (NACUAA WA)与多家机构联合主办，汇聚顶尖音乐创作人才，全面开启报名征集。</p>
      </a>
    </div>

    <!-- Leadership / Contact Box -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-8 space-y-6">
      <h3 class="text-lg font-bold text-white border-l-4 border-pink-500 pl-3">📞 俱乐部负责人与入群联系</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-200">
        <div class="bg-slate-950/50 border border-slate-800 rounded-2xl p-4 space-y-1">
          <div class="font-bold text-white text-sm">Xiaoyan Wan</div>
          <div class="text-slate-400">俱乐部总监 / 媒体与传播委员会主席</div>
          
        </div>
        <div class="bg-slate-950/50 border border-slate-800 rounded-2xl p-4 space-y-1">
          <div class="font-bold text-white text-sm">Ashley Qi (戚霄)</div>
          <div class="text-slate-400">Chapter President</div>
          <div class="flex flex-col gap-y-0.5">            <a href="mailto:ashley@nacuaa.ai" class="text-blue-400 hover:underline">ashley@nacuaa.ai</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
