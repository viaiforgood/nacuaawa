---
import type { Locale } from '../../i18n/locales';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import { CLUBS_DATA } from '../../data/clubs';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Hero Section -->
<section class="hero-bg pt-28 pb-16 md:pt-36 md:pb-24">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Announcement Banner -->
    <div class="mb-8 p-4 bg-blue-950/40 border border-blue-900/30 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-left">
      <div class="flex items-start gap-x-3">
        <div class="w-8 h-8 rounded-lg bg-blue-600/10 text-blue-400 flex items-center justify-center shrink-0 border border-blue-500/10">
          <i class="fa-solid fa-bullhorn text-sm animate-pulse"></i>
        </div>
        <div>
          <span class="text-xs text-blue-400 font-semibold uppercase tracking-wider block">
            {lang === 'en' ? 'Announcement' : lang === 'zh-TW' ? '重磅公告' : '重磅公告'}
          </span>
          <span class="text-sm text-slate-200 font-medium block mt-0.5">
            {lang === 'en' 
              ? 'Four NACUAA Chapters (NorCal, SV, NC, DC) Form Sister Chapter Alliance & Partner with ZJUAANC'
              : lang === 'zh-TW'
              ? '【重大新聞】北美高校聯盟四分會結為姊妹分會，並與浙江大學北卡羅來納校友會建立戰略合作'
              : '【重大新闻】北美高校联盟四分会结为姊妹分会，并与浙江大学北卡罗来纳校友会建立战略合作'}
          </span>
        </div>
      </div>
      <a href={lang === 'en' 
        ? '/en/posts/2026-09-12-four-chapters-sisterhood-and-zju-strategic-partnership/' 
        : lang === 'zh-TW'
        ? '/zh-TW/posts/2026-09-12-four-chapters-sisterhood-and-zju-strategic-partnership/'
        : '/posts/2026-09-12-four-chapters-sisterhood-and-zju-strategic-partnership/'} 
         class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-xl shrink-0 transition-colors text-center">
        {lang === 'en' ? 'Learn More' : '了解详情'}
      </a>
    </div>

    <div class="grid md:grid-cols-12 gap-12 items-center">
      <!-- Left content -->
      <div class="md:col-span-7 text-center md:text-left">
        <div class="inline-flex items-center gap-x-2 bg-slate-900 border border-slate-800 rounded-full px-4 py-1.5 mb-6">
          <div class="w-2 h-2 bg-blue-400 rounded-full animate-pulse"></div>
          <span class="text-blue-400 text-sm font-medium">{t('hero.badge')}</span>
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tighter leading-none mb-4 text-white">
          {t('hero.title_part1')}<br>
          <span class="ai-gradient">{t('hero.title_part2')}</span>
        </h1>
        
        <p class="max-w-md mx-auto md:mx-0 text-xl text-slate-400 mb-8">
          {t('hero.subtitle')}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4">
          <a href="#join" 
             class="w-full sm:w-auto px-8 py-4 bg-white hover:bg-slate-100 transition-all text-slate-900 font-semibold rounded-3xl flex items-center justify-center gap-x-2 text-lg">
            <span>{t('hero.cta.join')}</span>
          </a>
          <a href="#activities" 
             class="w-full sm:w-auto px-8 py-4 border border-slate-800 hover:bg-slate-900 hover:text-white text-slate-300 transition-all font-medium rounded-3xl flex items-center justify-center gap-x-2 text-lg">
            <span>{t('hero.cta.activities')}</span>
          </a>
        </div>
        
        <div class="mt-12 flex justify-center md:justify-start gap-x-8 text-sm text-slate-500">
          <div class="flex items-center gap-x-2">
            <i class="fa-solid fa-users"></i>
            <span>{t('hero.stat.members')}</span>
          </div>
          <div class="flex items-center gap-x-2">
            <i class="fa-solid fa-globe"></i>
            <span>{t('hero.stat.universities')}</span>
          </div>
        </div>
      </div>
      
      <!-- Right image (Hero) -->
      <div class="md:col-span-5 flex justify-center w-full">
        <div class="relative group w-full max-w-lg md:max-w-none">
          <!-- Ambient glowing background effect -->
          <div class="absolute -inset-1 bg-gradient-to-r from-blue-500 via-purple-600 to-pink-500 rounded-3xl blur opacity-35 group-hover:opacity-55 transition duration-1000"></div>
          <img src="/images/hero-banner.jpg" 
               alt="NACUAA WA Seattle Alumni Community Banner" 
               class="relative w-full aspect-[16/9] rounded-3xl object-cover shadow-2xl border border-slate-900 transition-transform duration-500 group-hover:scale-[1.01]" />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- About Section -->
<section id="about" class="max-w-5xl mx-auto px-6 py-16 md:py-24">
  <div class="grid md:grid-cols-12 gap-y-12 gap-x-8">
    <div class="md:col-span-5">
      <div class="sticky top-24">
        <span class="text-blue-500 font-semibold tracking-widest text-sm uppercase">{t('about.header')}</span>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mt-3 heading-font leading-tight">
          {t('about.title')}
        </h2>
      </div>
    </div>
    
    <div class="md:col-span-7 text-lg text-slate-300 space-y-8">
      <div class="space-y-6">
        <p>
          {t('about.body1')}
        </p>
        <p>
          {t('about.body2')}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-slate-900/60 border border-slate-900 rounded-2xl p-5 hover:border-slate-800 transition-colors">
          <div class="text-blue-500 mb-2"><i class="fa-solid fa-users-rectangle fa-lg"></i></div>
          <div class="font-semibold text-white">{t('about.pillar1.title')}</div>
          <div class="text-sm text-slate-400 mt-1">{t('about.pillar1.desc')}</div>
        </div>
        <div class="bg-slate-900/60 border border-slate-900 rounded-2xl p-5 hover:border-slate-800 transition-colors">
          <div class="text-blue-500 mb-2"><i class="fa-solid fa-graduation-cap fa-lg"></i></div>
          <div class="font-semibold text-white">{t('about.pillar2.title')}</div>
          <div class="text-sm text-slate-400 mt-1">{t('about.pillar2.desc')}</div>
        </div>
        <div class="bg-slate-900/60 border border-slate-900 rounded-2xl p-5 hover:border-slate-800 transition-colors">
          <div class="text-blue-500 mb-2"><i class="fa-solid fa-heart fa-lg"></i></div>
          <div class="font-semibold text-white">{t('about.pillar3.title')}</div>
          <div class="text-sm text-slate-400 mt-1">{t('about.pillar3.desc')}</div>
        </div>
      </div>

      <!-- Leadership Team -->
      <div class="pt-8 border-t border-slate-900/80">
        <h3 class="text-xl font-semibold text-white mb-6 heading-font">{t('about.leadership.title')}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-slate-900/40 border border-slate-900 rounded-2xl p-5 flex items-center gap-x-4">
            <img src="/images/ashley.jpg" alt="Ashley Qi (戚霄)" class="w-14 h-14 rounded-full object-cover border-2 border-blue-500/30 shadow-md shrink-0" />
            <div>
              <div class="font-semibold text-white text-base">
                {lang === 'en' ? 'Ashley Qi (戚霄)' : lang === 'zh-TW' ? '戚霄 (Ashley Qi)' : '戚霄 (Ashley Qi)'}
              </div>
              <div class="text-xs text-slate-400 mt-0.5">{t('about.leadership.president.label')}</div>
              <div class="flex flex-col gap-y-1 mt-1 text-xs">
                <a href="mailto:ashley@nacuaa.ai" class="text-blue-500 hover:text-blue-400 hover:underline flex items-center gap-x-1">
                  <i class="fa-regular fa-envelope"></i>
                  ashley@nacuaa.ai
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

        <!-- Department Structure (部门设置) -->
        <div class="pt-10 mt-10 border-t border-slate-900/80">
          <div class="mb-6">
            <h3 class="text-xl font-semibold text-white heading-font">
              {lang === 'en' ? 'Department Structure' : lang === 'zh-TW' ? '部門設置' : '部门设置'}
            </h3>
            <p class="text-xs text-slate-400 mt-1">
              {lang === 'en' ? 'Current committees and department structure of NACUAA WA' : lang === 'zh-TW' ? '北美高校聯盟華盛頓州分會當前部門架構' : '北美高校联盟华盛顿州分会当前部门架构'}
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
            <!-- Dept 1: Media & Communications -->
            <div class="bg-slate-900/40 border border-slate-900 rounded-2xl p-5 hover:border-blue-500/30 transition-colors">
              <div class="flex items-center gap-x-3 mb-2">
                <div class="w-9 h-9 rounded-xl bg-blue-600/10 text-blue-400 flex items-center justify-center shrink-0 border border-blue-500/10 text-sm">
                  <i class="fa-solid fa-bullhorn"></i>
                </div>
                <div class="font-semibold text-white text-sm">
                  {lang === 'en' ? 'Media & Communications Committee (宣传部)' : lang === 'zh-TW' ? '媒體與傳播委員會（宣傳部）' : '媒体与传播委员会（宣传部）'}
                </div>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                {lang === 'en' ? 'Responsible for content creation, graphic design, social media, and event publicity.' : lang === 'zh-TW' ? '負責內容創作、設計、社交媒體及活動宣傳。' : '负责内容创作、设计、社交媒体及活动宣传。'}
              </p>
            </div>

            <!-- Dept 2: IT -->
            <div class="bg-slate-900/40 border border-slate-900 rounded-2xl p-5 hover:border-blue-500/30 transition-colors">
              <div class="flex items-center gap-x-3 mb-2">
                <div class="w-9 h-9 rounded-xl bg-blue-600/10 text-blue-400 flex items-center justify-center shrink-0 border border-blue-500/10 text-sm">
                  <i class="fa-solid fa-laptop-code"></i>
                </div>
                <div class="font-semibold text-white text-sm">
                  {lang === 'en' ? 'IT & Systems Committee (信息部)' : lang === 'zh-TW' ? '資訊技術委員會（資訊部）' : '信息技术委员会（信息部）'}
                </div>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                {lang === 'en' ? 'Responsible for information systems, website building/maintenance, tech tools, and digital support.' : lang === 'zh-TW' ? '負責資訊管理、網站建設與維護、技術工具及數位化支持。' : '负责信息管理、网站建设与维护、技术工具及数字化支持。'}
              </p>
            </div>

            <!-- Dept 3: AI Venture -->
            <div class="bg-slate-900/40 border border-slate-900 rounded-2xl p-5 hover:border-blue-500/30 transition-colors">
              <div class="flex items-center gap-x-3 mb-2">
                <div class="w-9 h-9 rounded-xl bg-purple-600/10 text-purple-400 flex items-center justify-center shrink-0 border border-purple-500/10 text-sm">
                  <i class="fa-solid fa-brain"></i>
                </div>
                <div class="font-semibold text-white text-sm">
                  {lang === 'en' ? 'AI Venture & Innovation Committee (AI部)' : lang === 'zh-TW' ? 'AI創業與創新委員會（AI部）' : 'AI创业与创新委员会（AI部）'}
                </div>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                {lang === 'en' ? 'Responsible for AI lectures, startup workshops, technical exchanges, and resource matchmaking.' : lang === 'zh-TW' ? '負責AI相關講座、創業分享、技術交流與資源對接。' : '负责AI相关讲座、创业分享、技术交流与资源对接。'}
              </p>
            </div>

            <!-- Dept 4: Culture & Sports -->
            <div class="bg-slate-900/40 border border-slate-900 rounded-2xl p-5 hover:border-blue-500/30 transition-colors">
              <div class="flex items-center gap-x-3 mb-2">
                <div class="w-9 h-9 rounded-xl bg-emerald-600/10 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/10 text-sm">
                  <i class="fa-solid fa-icons"></i>
                </div>
                <div class="font-semibold text-white text-sm">
                  {lang === 'en' ? 'Culture, Sports & Outdoors Committee (活动部)' : lang === 'zh-TW' ? '文體與戶外活動委員會（活動部）' : '文体与户外活动委员会（活动部）'}
                </div>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                {lang === 'en' ? 'Responsible for planning and executing arts, music, outdoor sports, and social activities.' : lang === 'zh-TW' ? '負責文藝、音樂、戶外及各類活動的策劃與執行。' : '负责文艺、音乐、户外及各类活动的策划与执行。'}
              </p>
            </div>

            <!-- Dept 5: Membership & Relations -->
            <div class="bg-slate-900/40 border border-slate-900 rounded-2xl p-5 hover:border-blue-500/30 transition-colors">
              <div class="flex items-center gap-x-3 mb-2">
                <div class="w-9 h-9 rounded-xl bg-amber-600/10 text-amber-400 flex items-center justify-center shrink-0 border border-amber-500/10 text-sm">
                  <i class="fa-solid fa-users-viewfinder"></i>
                </div>
                <div class="font-semibold text-white text-sm">
                  {lang === 'en' ? 'Membership & Alumni Relations Committee (会员部)' : lang === 'zh-TW' ? '會員發展與校友聯絡委員會（會員部）' : '会员发展与校友联络委员会（会员部）'}
                </div>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                {lang === 'en' ? 'Responsible for member onboarding, alumni networking, and outreach to enterprises, governments, and nonprofits.' : lang === 'zh-TW' ? '負責新會員發展、校友聯絡，以及與企業、政府、其他非營利機構的對接。' : '负责新会员发展、校友联络，以及与企业、政府、其他非营利机构的对接。'}
              </p>
            </div>

            <!-- Dept 6: Honorary Advisory -->
            <div class="bg-slate-900/40 border border-slate-900 rounded-2xl p-5 hover:border-blue-500/30 transition-colors">
              <div class="flex items-center gap-x-3 mb-2">
                <div class="w-9 h-9 rounded-xl bg-rose-600/10 text-rose-400 flex items-center justify-center shrink-0 border border-rose-500/10 text-sm">
                  <i class="fa-solid fa-award"></i>
                </div>
                <div class="font-semibold text-white text-sm">
                  {lang === 'en' ? 'Honorary Advisory Committee (荣誉顾问)' : lang === 'zh-TW' ? '榮譽顧問委員會（榮譽顧問）' : '荣誉顾问委员会（荣誉顾问）'}
                </div>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed">
                {lang === 'en' ? 'Honorary positions for former presidents and council members, purely advisory with no operational duties.' : lang === 'zh-TW' ? '安置歷任掛名會長、理事，純榮譽性質，不承擔實際工作。' : '安置历任挂名会长、理事，纯荣誉性质，不承担实际工作。'}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Clubs Section -->
<section id="clubs" class="bg-slate-900/10 border-t border-slate-900/80">
  <div class="max-w-5xl mx-auto px-6 py-16 md:py-24">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <span class="text-blue-500 font-semibold tracking-widest text-sm uppercase">{t('clubs.header')}</span>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mt-2 heading-font">
          {lang === 'en' ? 'Alumni Theme Clubs' : lang === 'zh-TW' ? '校友主題俱樂部' : '校友主题俱乐部'}
        </h2>
        <p class="text-slate-400 text-sm md:text-base mt-2 max-w-2xl leading-relaxed">
          {lang === 'en' 
            ? 'Official club names are used externally, while WeChat group names are used for joining groups. Warmly welcome all alumni in Washington State and the Greater Seattle area!' 
            : lang === 'zh-TW' 
            ? '對外使用正式俱樂部名，進群使用現成微信群名。歡迎華盛頓州與大西雅圖廣大校友與朋友積極加入！' 
            : '对外使用正式俱乐部名，进群使用现成微信群名。欢迎华盛顿州与大西雅图广大校友与朋友积极加入！'}
        </p>
      </div>
      <a href={getLocalizedPath('/clubs/', lang)} 
         class="inline-flex items-center gap-x-2 text-sm text-blue-400 hover:text-blue-300 font-semibold transition-colors shrink-0">
        <span>{lang === 'en' ? 'View All Clubs' : lang === 'zh-TW' ? '瀏覽全部俱樂部' : '浏览全部俱乐部'}</span>
        <i class="fa-solid fa-arrow-right text-xs"></i>
      </a>
    </div>

    <!-- Waiver Notice Bar -->
    <div class="mb-8 p-4 rounded-2xl bg-blue-950/20 border border-blue-900/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-x-2.5 text-slate-300">
        <i class="fa-solid fa-file-signature text-blue-400 text-sm"></i>
        <span>
          {lang === 'en' 
            ? 'Participating in offline club activities? Please complete the Activity Liability Waiver before attendance.' 
            : lang === 'zh-TW'
            ? '參加各俱樂部線下體育與社交活動？請於行前在線簽署《活動免責聲明與責任豁免協議》。'
            : '参加各俱乐部线下体育与社交活动？请于行前在线签署《活动免责声明与责任豁免协议》。'}
        </span>
      </div>
      <a href={getLocalizedPath('/waiver/', lang)} class="text-blue-400 hover:text-blue-300 font-semibold inline-flex items-center gap-x-1 shrink-0">
        <span>{lang === 'en' ? 'Sign Waiver Online →' : '前往签署免责协议 →'}</span>
      </a>
    </div>

    <!-- 9 Clubs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {CLUBS_DATA.map((club) => (
        <div class="bg-slate-900/40 border border-slate-900 hover:border-slate-800 rounded-3xl p-6 flex flex-col justify-between hover:bg-slate-900/60 transition-all duration-300 group shadow-xl">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-2xl bg-slate-800 text-2xl flex items-center justify-center border border-slate-700 shadow-inner group-hover:scale-105 transition-transform">
                <span>{club.emoji}</span>
              </div>
              <a href={`mailto:${club.directorEmail}`} class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-blue-600/10 text-blue-400 border border-blue-500/20 hover:border-blue-400 transition-colors flex items-center gap-x-1">
                <i class="fa-regular fa-user text-[10px]"></i>
                <span>{lang === 'en' ? club.directorEn : lang === 'zh-TW' ? club.directorTw : club.directorZh}</span>
              </a>
            </div>

            <div class="mb-2">
              <h3 class="text-lg font-bold text-white group-hover:text-blue-400 transition-colors leading-snug">
                {lang === 'en' ? club.nameEn : lang === 'zh-TW' ? club.nameTw : club.nameZh}
              </h3>
              <div class="text-xs text-slate-400">
                {lang === 'en' ? club.nameZh : club.nameEn}
              </div>
            </div>

            <div class="bg-slate-950/60 border border-slate-800/80 rounded-xl p-2.5 mb-3 text-xs">
              <div class="text-[10px] text-slate-400 flex items-center gap-x-1 mb-0.5">
                <i class="fa-brands fa-weixin text-emerald-400"></i>
                <span>{lang === 'en' ? 'Group Name:' : '进群群名：'}</span>
              </div>
              <div class="font-mono text-slate-200 text-xs truncate">
                {lang === 'zh-TW' ? club.groupNameTw : club.groupNameZh}
              </div>
            </div>

            <p class="text-xs text-slate-400 leading-relaxed line-clamp-2 mb-4">
              {lang === 'en' ? club.descEn : lang === 'zh-TW' ? club.descTw : club.descZh}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-800/60">
            <a href={club.route} class="inline-flex items-center gap-x-2 text-xs text-blue-400 hover:text-blue-300 font-semibold group-hover:underline">
              <span>{lang === 'en' ? 'Explore Club' : '查看俱乐部'}</span>
              <i class="fa-solid fa-arrow-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Recent News & Events Section -->
<section id="posts" class="border-t border-slate-900/80 bg-slate-950/60">
  <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <span class="text-blue-500 font-semibold tracking-widest text-sm uppercase">
          {lang === 'en' ? 'News & Events' : lang === 'zh-TW' ? '新聞與活動' : '新闻与活动'}
        </span>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mt-2 heading-font">
          {lang === 'en' ? 'Recent Updates & Activities' : lang === 'zh-TW' ? '最新動態與活動' : '最新动态与活动'}
        </h2>
      </div>
      <a href={lang === 'en' ? '/en/posts/' : lang === 'zh-TW' ? '/zh-TW/posts/' : '/posts/'} 
         class="inline-flex items-center gap-x-2 text-sm text-blue-400 hover:text-blue-300 font-semibold transition-colors">
