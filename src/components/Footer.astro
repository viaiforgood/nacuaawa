---
import type { Locale } from '../i18n/locales';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="border-t border-slate-900 bg-slate-950">
  <div class="max-w-5xl mx-auto px-6 py-10 text-sm space-y-8">
    <!-- Activity Liability Waiver Callout -->
    <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-blue-950/40 via-slate-900/60 to-slate-900/40 border border-blue-900/40 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-start sm:items-center gap-x-3 text-slate-300 text-xs sm:text-sm">
        <div class="w-8 h-8 rounded-xl bg-blue-600/10 text-blue-400 border border-blue-500/20 flex items-center justify-center shrink-0">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div>
          <span class="font-semibold text-white block sm:inline">
            {lang === 'en' ? 'Activity Safety & Compliance:' : lang === 'zh-TW' ? '活動安全與合規須知：' : '活动安全与合规须知：'}
          </span>
          <span class="text-slate-400">
            {lang === 'en'
              ? ' Participants in offline sports, hiking, or social events must complete the digital waiver prior to attendance.'
              : lang === 'zh-TW'
              ? ' 參加各俱樂部線下體育、健行或交流活動前，請務必於行前完成電子簽署。'
              : ' 参加各俱乐部线下体育、健行或交流活动前，请务必于行前完成电子签署。'}
          </span>
        </div>
      </div>
      <a href={getLocalizedPath('/waiver/', lang)} 
         class="inline-flex items-center gap-x-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-medium text-xs transition-colors shrink-0 shadow-sm">
        <i class="fa-solid fa-file-signature text-[11px]"></i>
        <span>{lang === 'en' ? 'Sign Waiver Online' : '在线签署免责声明'}</span>
      </a>
    </div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-y-4 text-slate-400">
      <div>
        {t('footer.rights')}<br>
        <span class="text-xs text-slate-500">{t('footer.alliance')}</span>
      </div>
      
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-slate-400">
        <a href="http://nacuaa.org" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">{t('footer.link.parent')}</a>
        <a href="https://nacuaa.ai" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors text-blue-400 font-medium flex items-center gap-x-1">
          <i class="fa-solid fa-brain text-xs"></i>
          <span>{t('footer.link.aiclub')}</span>
        </a>
        <a href="https://chinesemusic.ai" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors text-pink-400 font-medium flex items-center gap-x-1">
          <i class="fa-solid fa-music text-xs"></i>
          <span>{t('footer.link.chinesemusic')}</span>
        </a>
        <a href="mailto:contact@wa.nacuaa.ai" class="hover:text-white transition-colors">{t('footer.link.contact')}</a>
        <a href="mailto:ashley@nacuaa.ai" class="hover:text-white transition-colors">ashley@nacuaa.ai</a>
        <a href={getLocalizedPath('/waiver/', lang)} class="hover:text-white transition-colors">{t('nav.waiver')}</a>
        <a href="#about" class="hover:text-white transition-colors">{t('nav.about')}</a>
      </div>
    </div>

    <!-- Chapters & Regional Ecosystem -->
    <div class="border-t border-slate-900 pt-6 space-y-4">
      <!-- NorCal Chapter & Sub-Chapters -->
      <div class="space-y-2">
        <div class="text-[11px] font-semibold text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
          <i class="fa-solid fa-sitemap text-blue-400 text-xs"></i>
          <span>
            {lang === 'en' 
              ? 'Northern California Chapter & Sub-Chapters (Dual-Hub Structure)' 
              : lang === 'zh-TW' 
              ? '北加州分會及下轄分會（大區統領 · 雙核驅動）' 
              : '北加州分会及下辖分会（大区统领 · 双核驱动）'}
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-slate-400">
          <a href="https://norcal.nacuaa.ai" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors font-medium text-slate-300">
            {lang === 'en' ? 'NorCal Regional Chapter (HQ)' : lang === 'zh-TW' ? '北美高校聯盟北加州分會（大區主管）' : '北美高校联盟北加州分会（大区主管）'}
          </a>
          <span class="text-slate-700">|</span>
          <a href="https://sv.nacuaa.ai" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">
            {lang === 'en' ? 'Silicon Valley Chapter' : lang === 'zh-TW' ? '硅谷分會（矽谷）' : '硅谷分会（南湾/半岛）'}
          </a>
          <span class="text-slate-700">·</span>
          <a href="https://sf.nacuaa.ai" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">
            {lang === 'en' ? 'San Francisco Chapter' : lang === 'zh-TW' ? '舊金山分會（市區）' : '旧金山分会（核心市区）'}
          </a>
        </div>
      </div>

      <!-- Cross-Regional Sister Chapters & HQ -->
      <div class="space-y-2">
        <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
          <i class="fa-solid fa-earth-americas text-purple-400 text-xs"></i>
          <span>
            {lang === 'en' 
              ? 'Cross-Regional Sister Chapters & Alliance HQ' 
              : lang === 'zh-TW' 
              ? '全美跨區姊妹分會與總會' 
              : '全美跨区姊妹分会与总会'}
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-slate-400">
          <a href="https://wa.nacuaa.ai" class="text-white font-medium hover:text-blue-400 transition-colors flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            <span>{lang === 'en' ? 'Washington State Chapter (Seattle)' : lang === 'zh-TW' ? '華盛頓州分會（西雅圖）' : '华盛顿州分会（西雅图）'}</span>
          </a>
          <a href="https://nacuaa.ai" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors text-blue-400 font-medium">
            {lang === 'en' ? 'NACUAA HQ' : lang === 'zh-TW' ? '北美高校聯盟總會' : '北美高校联盟总会'}
          </a>
          <a href="https://dc.nacuaa.ai" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            {lang === 'en' ? 'Greater Washington DC Chapter' : lang === 'zh-TW' ? '華盛頓DC大華府分會' : '华盛顿DC大华府分会'}
          </a>
          <a href="https://nc.nacuaa.ai" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            {lang === 'en' ? 'North Carolina Chapter' : lang === 'zh-TW' ? '北卡分會' : '北卡分会'}
          </a>
          <a href="https://sc.nacuaa.ai" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            {lang === 'en' ? 'Southern California Chapter' : lang === 'zh-TW' ? '南加分會' : '南加分会'}
          </a>
        </div>
      </div>
    </div>

    <div class="mt-8 border-t border-slate-900 pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-y-4 text-xs text-slate-500">
      <p>
        <span>{t('footer.supported_by')}</span>{' '}
        <a href="https://viaiforgood.org" target="_blank" rel="noopener noreferrer" class="font-medium text-blue-500 hover:text-blue-400 hover:underline">
          {t('footer.supported_by.name')}
        </a>
        <span> · {t('footer.supported_by.desc')}</span>
      </p>
    </div>
  </div>
</footer>
